# ==============================================================================
# Rust / Cargo Build Artifacts
# ==============================================================================
target/
**/target/
debug/
release/
*.pdb
*.exe
*.dll
*.so
*.dylib
*.rlib
**/*.rs.bk
rustc-ice-*.txt
**/mutants.out*/
.cargo-ok

# Cargo Credentials & Private Config
.cargo/credentials
.cargo/credentials.toml

# ==============================================================================
# Environment & Secrets (API keys, tokens, passwords)
# ==============================================================================
.env
.env.*
*.env
# Allow tracking example environment configurations
!.env.example
!*.env.example
!.env.*.example

