# ==============================================================================
# Hydra Judge Echo Server — Конфигурационный файл окружения (.env.example)
# Модуль: hydra_judge (Автономный высокопроизводительный L7 Echo-сервер)
# Запуск: cargo run -p hydra_judge
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Сетевые порты и адреса привязки
# ------------------------------------------------------------------------------
# TCP-порт для входящих незашифрованных HTTP-запросов (слушает 0.0.0.0:<HTTP_PORT>).
# Формат: целое число 1..65535.
# По умолчанию: 8080
# Обязательность: Опционально
HTTP_PORT=8080

# TCP-порт для входящих защищенных HTTPS/TLS-запросов (слушает 0.0.0.0:<HTTPS_PORT>).
# Если не задан — сервер работает только по обычному протоколу HTTP.
# Если задан без явных путей TLS_CERT_PATH/TLS_KEY_PATH — генерируется самоподписанный TLS.
# Формат: целое число 1..65535.
# По умолчанию: не задан (HTTPS отключен)
# Обязательность: Опционально
# HTTPS_PORT=8443

# ------------------------------------------------------------------------------
# 2. Аутентификация и защита от сканеров (Anti-Abuse Token Guard)
# ------------------------------------------------------------------------------
# Секретный статический токен для авторизации входящих запросов к Judge.
# Клиент обязан передать этот токен одним из трех способов:
#   1. В строке запроса: `?token=<SECRET_TOKEN>`
#   2. В пути URL: `/token/<SECRET_TOKEN>/...`
#   3. В HTTP-заголовке: `X-Hydra-Token: <SECRET_TOKEN>`
# Значение токена также возвращается в теле ответа Judge для валидации чекером.
# Формат: произвольная строка
# По умолчанию: hydra_secret_token
# Обязательность: Опционально
SECRET_TOKEN=hydra_secret_token

# Секретный мастер-ключ HMAC-SHA256 для посуточной динамической ротации токенов.
# Если задан — статический токен заменяется на динамический, меняющийся каждые сутки (UTC)
# с поддержкой 30-минутного окна плавного перехода в полночь.
# Должен быть идентичен JUDGE_SECRET_KEY на проверяющем узле (hydra_checker / hydra_api).
# Формат: 64-символьная hex-строка или криптостойкий секрет.
# По умолчанию: не задан (используется статический SECRET_TOKEN)
# Обязательность: Опционально
# SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Поведение сервера при получении запроса без валидного токена (от сканеров интернета):
#   - `drop_rst` : мгновенный жесткий разрыв TCP-соединения через SO_LINGER=0.
#                 Не передает ни одного байта, не тратит CPU, маскирует сервис под закрытый порт.
#   - `http_403` : отправка аккуратного HTTP-ответа 403 Forbidden с Connection: close.
# Формат: drop_rst | http_403
# По умолчанию: drop_rst
# Обязательность: Опционально
UNAUTHORIZED_ACTION=drop_rst

# ------------------------------------------------------------------------------
# 3. Формат эхо-ответа
# ------------------------------------------------------------------------------
# Формат вывода заголовков и метаданных клиента:
#   - `azenv` : сверхбыстрый текстовый azenv-формат (REMOTE_ADDR = ..., HTTP_USER_AGENT = ...)
#   - `json`  : структурированный JSON формат с ключами `headers`, `origin`, `token`
# Формат: azenv | json
# По умолчанию: azenv
# Обязательность: Опционально
FORMAT=azenv

# ------------------------------------------------------------------------------
# 4. Пользовательские TLS-сертификаты (для HTTPS-режима)
# ------------------------------------------------------------------------------
# Пути к файлам X.509 сертификата (PEM) и приватного ключа (PEM PKCS#8).
# Если не заданы при включенном HTTPS_PORT, Judge генерирует самоподписанный сертификат.
# Формат: файловые пути
# По умолчанию: не заданы
# Обязательность: Опционально
# TLS_CERT_PATH=/etc/ssl/certs/judge.crt
# TLS_KEY_PATH=/etc/ssl/private/judge.key

# ------------------------------------------------------------------------------
# 5. Лимиты безопасности, производительности и таймауты
# ------------------------------------------------------------------------------
# Максимальный размер входящего HTTP-запроса в байтах (минимум 512 байт).
# Предотвращает попытки переполнения буфера или истощения памяти.
# По умолчанию: 4096 (4 КБ)
# Обязательность: Опционально
MAX_REQUEST_BYTES=4096

# Таймаут на чтение полного запроса и отправку ответа клиенту (в секундах).
# По умолчанию: 3
# Обязательность: Опционально
REQUEST_TIMEOUT_SECS=3

# Лимит одновременных активных соединений (семафор защиты от перегрузки / DoS / OOM).
# По умолчанию: 10000
# Обязательность: Опционально
MAX_CONCURRENT_CONNECTIONS=10000

# ------------------------------------------------------------------------------
# 6. Логирование и трассировка (RUST_LOG)
# ------------------------------------------------------------------------------
# Уровень детализации вывода (error, warn, info, debug, trace).
# По умолчанию: info
# Обязательность: Опционально
RUST_LOG=info,hydra_judge=debug
