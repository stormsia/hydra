# ==============================================================================
# Hydra Judge Echo Server — Конфигурационный файл окружения (.env.example)
# Модуль: hydra_judge (Автономный высокопроизводительный L7 Echo-сервер)
# Запуск: cargo run -p hydra_judge
# ==============================================================================

# ==============================================================================
# 1. ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (REQUIRED)
# ==============================================================================
# В модуле hydra_judge отсутствуют строго обязательные переменные: отсутствие
# любой из них НЕ приводит к ошибке старта или панике. Модуль готов к работе
# "из коробки" с безопасными дефолтами (0.0.0.0:8080, статический токен, azenv, TCP RST).
#
# ВНИМАНИЕ (Безопасность): В production-окружении для предотвращения несанкционированного
# использования эхо-сервера сторонними сканерами рекомендуется ОБЯЗАТЕЛЬНО задать
# собственный SECRET_TOKEN или криптографический ключ SECRET_KEY.


# ==============================================================================
# 2. НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (OPTIONAL & DEFAULTS)
# ==============================================================================

# ------------------------------------------------------------------------------
# Сетевые порты и сетевые интерфейсы (Network & Ports)
# ------------------------------------------------------------------------------

# TCP-порт для входящих незашифрованных HTTP-запросов (привязка к 0.0.0.0:<HTTP_PORT>).
# Формат: целое число 1..65535
# [DEFAULT: 8080]
HTTP_PORT=8080

# TCP-порт для входящих защищенных HTTPS/TLS-запросов (привязка к 0.0.0.0:<HTTPS_PORT>).
# Если не задан — сервер работает исключительно по протоколу HTTP.
# Если задан без указания путей TLS_CERT_PATH/TLS_KEY_PATH — на лету генерируется
# самоподписанный TLS-сертификат (rcgen) для localhost/127.0.0.1.
# Формат: целое число 1..65535
# [DEFAULT: не задан (HTTPS отключен)]
# HTTPS_PORT=8443

# ------------------------------------------------------------------------------
# Аутентификация и защита от сканеров (Anti-Abuse Token Guard)
# ------------------------------------------------------------------------------

# Секретный статический токен для авторизации входящих запросов к эхо-серверу Judge.
# Клиент обязан передать токен одним из трех способов:
#   1. Query-параметр: `?token=<SECRET_TOKEN>`
#   2. Путь запроса (любой сегмент): `/<SECRET_TOKEN>` или `/token/<SECRET_TOKEN>`
#   3. HTTP-заголовок: `X-Hydra-Token: <SECRET_TOKEN>`
# Активный токен отражается в теле ответа Judge для верификации чекером.
# Игнорируется, если задан мастер-ключ SECRET_KEY.
# Формат: произвольная непустая строка
# [DEFAULT: hydra_secret_token]
SECRET_TOKEN=hydra_secret_token

# Секретный мастер-ключ HMAC-SHA256 для детерминированной посуточной ротации токенов.
# Если задан — статический токен отключается, и токен меняется каждые сутки (UTC).
# Для надежности и защиты от рассинхронизации часов Judge принимает токены
# за текущие (today) и предыдущие (yesterday) UTC-сутки (24-часовое окно перехода).
# Должен совпадать с JUDGE_SECRET_KEY на стороне чекера (hydra_checker / hydra_api).
# Формат: hex-строка (например, 64 hex-символа) или криптостойкий секрет
# [DEFAULT: не задан (используется статический токен SECRET_TOKEN)]
# SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Поведение сервера при получении запроса без валидного токена авторизации:
#   - drop_rst : мгновенный жесткий сброс TCP-соединения через SO_LINGER=0 (TCP RST).
#                Не отправляет ни байта ответа, не расходует CPU, не переходит в TIME_WAIT,
#                эффективно маскируя эхо-сервер под закрытый порт от Shodan/Censys.
#   - http_403 : отправка аккуратного HTTP-ответа 403 Forbidden с заголовком Connection: close.
# Формат: drop_rst | http_403 (регистронезависимо)
# [DEFAULT: drop_rst]
UNAUTHORIZED_ACTION=drop_rst

# ------------------------------------------------------------------------------
# Формат эхо-ответа (Response Formatting)
# ------------------------------------------------------------------------------

# Базовый формат вывода отраженных заголовков и метаданных клиента:
#   - azenv : высокопроизводительный компактный текстовый формат AZenv
#             (REMOTE_ADDR = ..., HTTP_USER_AGENT = ..., HYDRA_TOKEN = ...)
#   - json  : структурированный JSON-формат (origin, headers, token), совместимый с httpbin
# Клиент может динамически переопределить формат индивидуальным запросом:
#   - Через query-параметр: `?format=json` или `?format=azenv`
#   - Через заголовок: `Accept: application/json`
# Формат: azenv | json (регистронезависимо)
# [DEFAULT: azenv]
FORMAT=azenv

# ------------------------------------------------------------------------------
# Пользовательские TLS-сертификаты (Custom TLS Certificates)
# ------------------------------------------------------------------------------

# Путь к файлу открытого X.509 сертификата сервера в формате PEM.
# ВАЖНО: Параметры TLS_CERT_PATH и TLS_KEY_PATH должны задаваться строго в паре!
# Если задан только один из них или оба отсутствуют при активном HTTPS_PORT,
# Judge автоматически сгенерирует временный самоподписанный сертификат на лету.
# Формат: абсолютный или относительный путь к файлу PEM
# [DEFAULT: не задан (автогенерация самоподписанного сертификата)]
# TLS_CERT_PATH=/etc/ssl/certs/judge.crt

# Путь к файлу приватного ключа сервера в формате PEM (PKCS#8).
# Формат: абсолютный или относительный путь к файлу PEM
# [DEFAULT: не задан (автогенерация самоподписанного сертификата)]
# TLS_KEY_PATH=/etc/ssl/private/judge.key

# ------------------------------------------------------------------------------
# Лимиты безопасности, производительности и таймауты (Limits & Timeouts)
# ------------------------------------------------------------------------------

# Максимальный размер входящего HTTP-запроса в байтах (включая заголовки).
# В коде действует аппаратный минимум 512 байт (значения < 512 округляются до 512).
# Защищает от атак на переполнение буфера и истощение оперативной памяти.
# При превышении лимита входящее соединение немедленно сбрасывается.
# Формат: целое положительное число байт (>= 512)
# [DEFAULT: 4096]
MAX_REQUEST_BYTES=4096

# Таймаут на обработку клиентского соединения в секундах.
# Ограничивает суммарное время на TLS-хендшейк, чтение HTTP-запроса и отправку ответа.
# Служит надежной защитой от атак типа Slowloris / Slow POST.
# Формат: целое положительное число секунд (> 0)
# [DEFAULT: 3]
REQUEST_TIMEOUT_SECS=3

# Лимит одновременных активных клиентских соединений (семафор защиты от DoS и OOM).
# В коде действует аппаратный минимум 1.
# При исчерпании лимита новые TCP-соединения немедленно сбрасываются через TCP RST
# без аллокаций памяти и без расхода процессорного времени.
# Формат: целое положительное число (>= 1)
# [DEFAULT: 10000]
MAX_CONCURRENT_CONNECTIONS=10000

# ------------------------------------------------------------------------------
# Логирование и диагностика (Logging & Diagnostics)
# ------------------------------------------------------------------------------

# Уровень детализации логов для экосистемы Hydra.
# Автономный бинарник `hydra_judge` работает с максимальной скоростью без накладных
# расходов построчного логирования соединений, выводя базовые сообщения в stdout.
# Переменная RUST_LOG используется при интеграции с tracing-subscriber или при
# запуске в составе hydra_api / hydra_checker.
# Формат: error | warn | info | debug | trace, либо список директив target=level
# [DEFAULT: info]
RUST_LOG=info,hydra_judge=debug
