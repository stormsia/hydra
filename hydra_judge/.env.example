# ==============================================================================
# Hydra Judge Echo Server — Конфигурационный файл окружения (.env.example)
# Модуль: hydra_judge (Автономный высокопроизводительный L7 Echo-сервер)
# Запуск: cargo run -p hydra_judge
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Сетевые порты и адреса привязки
# ------------------------------------------------------------------------------
# TCP-порт для входящих незашифрованных HTTP-запросов (слушает 0.0.0.0:<HTTP_PORT>).
# Формат: целое число 1..65535.
# По умолчанию: 8080
# Обязательность: Опционально
HTTP_PORT=8080

# TCP-порт для входящих защищенных HTTPS/TLS-запросов (слушает 0.0.0.0:<HTTPS_PORT>).
# Если не задан — сервер работает только по обычному протоколу HTTP.
# Если задан без явных путей TLS_CERT_PATH/TLS_KEY_PATH — генерируется самоподписанный TLS-сертификат на лету.
# Формат: целое число 1..65535.
# По умолчанию: не задан (HTTPS отключен)
# Обязательность: Опционально
# HTTPS_PORT=8443

# ------------------------------------------------------------------------------
# 2. Аутентификация и защита от сканеров (Anti-Abuse Token Guard)
# ------------------------------------------------------------------------------
# Секретный статический токен для авторизации входящих запросов к Judge.
# Клиент обязан передать этот токен одним из трех способов:
#   1. В строке запроса (Query parameter): `?token=<SECRET_TOKEN>`
#   2. В пути URL (любой сегмент пути): `/<SECRET_TOKEN>` или `/token/<SECRET_TOKEN>`
#   3. В HTTP-заголовке: `X-Hydra-Token: <SECRET_TOKEN>`
# Значение активного токена возвращается в теле ответа Judge (`HYDRA_TOKEN = ...` или JSON `token`)
# для строгой валидации чекером.
# Формат: произвольная строка
# По умолчанию: hydra_secret_token
# Обязательность: Опционально
SECRET_TOKEN=hydra_secret_token

# Секретный мастер-ключ HMAC-SHA256 для посуточной динамической ротации токенов.
# Если задан — статический токен заменяется на динамический, детерминированно меняющийся каждые сутки (UTC).
# Для обеспечения непрерывности проверок и защиты от рассинхронизации часов Judge одновременно
# принимает токены за текущие (today) и предыдущие (yesterday) UTC-сутки (полное 24-часовое окно перехода).
# Должен быть идентичен значению JUDGE_SECRET_KEY на проверяющем узле (hydra_checker / hydra_api).
# Формат: шестнадцатеричная строка (например, 64 hex-символа) или криптостойкий секрет.
# По умолчанию: не задан (используется статический SECRET_TOKEN)
# Обязательность: Опционально
# SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Поведение сервера при получении запроса без валидного токена (от сканеров Censys/Shodan/интернета):
#   - `drop_rst` : мгновенный жесткий сброс TCP-соединения через SO_LINGER=0 (TCP RST).
#                 Не передает ни одного байта ответа, не расходует CPU, не переходит в TIME_WAIT,
#                 маскирует эхо-сервер под закрытый порт.
#   - `http_403` : отправка аккуратного HTTP-ответа 403 Forbidden с заголовком `Connection: close`.
# Формат: drop_rst | http_403 (регистронезависимо)
# По умолчанию: drop_rst
# Обязательность: Опционально
UNAUTHORIZED_ACTION=drop_rst

# ------------------------------------------------------------------------------
# 3. Формат эхо-ответа
# ------------------------------------------------------------------------------
# Формат вывода заголовков и метаданных клиента по умолчанию:
#   - `azenv` : сверхбыстрый текстовый azenv-формат (REMOTE_ADDR = ..., HTTP_USER_AGENT = ..., HYDRA_TOKEN = ...)
#   - `json`  : структурированный JSON-формат (origin, headers, token), совместимый с httpbin
# Клиент может динамически переопределить формат для конкретного запроса:
#   - Через параметр строки запроса: `?format=json` или `?format=azenv`
#   - Через заголовок: `Accept: application/json`
# Формат: azenv | json (регистронезависимо)
# По умолчанию: azenv
# Обязательность: Опционально
FORMAT=azenv

# ------------------------------------------------------------------------------
# 4. Пользовательские TLS-сертификаты (для HTTPS-режима)
# ------------------------------------------------------------------------------
# Пути к файлам X.509 сертификата (PEM) и приватного ключа (PEM PKCS#8).
# ВАЖНО: Оба параметра (TLS_CERT_PATH и TLS_KEY_PATH) должны быть заданы одновременно!
# Если задан только один из них или оба отсутствуют при включенном HTTPS_PORT,
# Judge автоматически сгенерирует самоподписанный сертификат для localhost/127.0.0.1 на лету.
# Формат: абсолютные или относительные пути к файлам PEM
# По умолчанию: не заданы (автогенерация самоподписанного сертификата)
# Обязательность: Опционально
# TLS_CERT_PATH=/etc/ssl/certs/judge.crt
# TLS_KEY_PATH=/etc/ssl/private/judge.key

# ------------------------------------------------------------------------------
# 5. Лимиты безопасности, производительности и таймауты
# ------------------------------------------------------------------------------
# Максимальный размер входящего HTTP-запроса в байтах (в коде принудительно ограничивается снизу: min 512 байт).
# Предотвращает попытки истощения памяти или переполнения заголовков.
# При превышении лимита соединение немедленно сбрасывается с инкрементом счетчика blocked_scanners.
# Формат: положительное целое число байт (>= 512)
# По умолчанию: 4096 (4 КБ)
# Обязательность: Опционально
MAX_REQUEST_BYTES=4096

# Таймаут на обработку соединения в секундах (включает TLS-хэндшейк, чтение запроса и запись ответа).
# Служит защитой от атак типа Slowloris.
# Формат: целое число секунд (> 0)
# По умолчанию: 3
# Обязательность: Опционально
REQUEST_TIMEOUT_SECS=3

# Лимит одновременных активных соединений (семафор защиты от перегрузки / DoS / OOM, min 1).
# При превышении лимита новые входящие TCP-соединения моментально отсекаются через TCP RST
# без выделения оперативной памяти и без траты ресурсов процессора.
# Формат: целое число (> 0)
# По умолчанию: 10000
# Обязательность: Опционально
MAX_CONCURRENT_CONNECTIONS=10000

# ------------------------------------------------------------------------------
# 6. Логирование и трассировка (RUST_LOG)
# ------------------------------------------------------------------------------
# Уровень детализации логов для экосистемы Hydra.
# ПРИМЕЧАНИЕ: Автономный бинарник `hydra_judge` оптимизирован под максимальную производительность
# и выводит статус запуска через прямой stdout без накладных расходов трассировки на каждое соединение.
# Переменная RUST_LOG учитывается при запуске встроенного Judge в составе `hydra_api` (EMBED_JUDGE=true)
# или при подключении подписчика трассировки.
# Формат: error | warn | info | debug | trace, либо список директив вида target=level
# По умолчанию: info
# Обязательность: Опционально
RUST_LOG=info,hydra_judge=debug
