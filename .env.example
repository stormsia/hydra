# ==============================================================================
# Hydra Proxy System — Полный эталонный конфигурационный файл (.env.example)
# Поддерживает настройку всех модулей воркспейса:
#   - hydra_api     (REST API, Swagger UI, планировщик, пакетный буфер, GeoIP)
#   - hydra_judge   (Авторизованный L7 Echo-сервер для валидации прокси)
#   - hydra_checker (Высокопроизводительное асинхронное ядро сетевых проверок L4/L7)
# ==============================================================================

# ==============================================================================
# 1. ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (REQUIRED)
# ==============================================================================
# Переменные, без которых запуск системы невозможен, либо необходимые для
# промышленной валидации прокси-серверов в распределенной среде.
#
# В модуле hydra_api отсутствие переменной API_KEY приводит к критической ошибке
# и аварийному завершению работы процесса на этапе инициализации.
# В модуле hydra_checker переменные JUDGE_HTTP_URL, JUDGE_HTTPS_URL и
# JUDGE_SECRET_TOKEN являются строго обязательными аргументами конструктора
# CheckerConfig::builder(...) и необходимы в production: без внешнего адреса Judge
# удаленные прокси не могут верифицировать эхо-ответ, а проверка маркера завершится сбоем.
# В модуле hydra_judge строго обязательные переменные отсутствуют (модуль готов к работе
# "из коробки" с безопасными дефолтами 0.0.0.0:8080 и drop_rst).

# Секретный мастер-ключ для авторизации клиентских запросов к REST API.
# Передается клиентом в обязательном HTTP-заголовке `X-API-Key: <значение>`.
# Защищает все рабочие эндпоинты API (кроме Swagger UI и схемы OpenAPI).
# Модуль: API (hydra_api)
# Назначение: Аутентификация и защита REST API
# Тип: String
# Обязательность: ОБЯЗАТЕЛЬНО (REQUIRED)
# [DEFAULT: отсутствует (без ключа запуск блокируется)]
# Допустимые значения: произвольная криптостойкая строка (рекомендуется от 32 символов)
API_KEY=hydra_super_secret_api_key_change_me_in_production

# Базовый HTTP URL сервера Judge для проверки незашифрованного HTTP трафика (Plain HTTP).
# Используется чекером для прямого HTTP GET запроса через прокси. Чекер автоматически
# выполняет DNS-предрезолвинг хоста и передает токен в query-параметре `?token=...`
# либо заменяет плейсхолдер `{TOKEN}` в пути URL.
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Сетевой адрес эхо-сервера для Plain HTTP проверок
# Тип: String (URL)
# Обязательность: ОБЯЗАТЕЛЬНО (REQUIRED в production для hydra_checker; в hydra_api имеет fallback)
# [DEFAULT: http://127.0.0.1:8080]
# Допустимые значения: http://<host>:<port>[/path] (может содержать плейсхолдер {TOKEN})
JUDGE_HTTP_URL=http://127.0.0.1:8080

# Базовый HTTPS URL сервера Judge для проверки защищенных туннелей.
# Применяется чекером при тестировании туннелирования: HTTP CONNECT, SOCKS4/4a и SOCKS5.
# Чекер выполняет предрезолвинг IP-адреса хоста для чистых IPv4 SOCKS4 проверок
# и кэширует предсформированный TLS HTTP-запрос для исключения лишних аллокаций.
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Сетевой адрес эхо-сервера для TLS/CONNECT/SOCKS проверок
# Тип: String (URL)
# Обязательность: ОБЯЗАТЕЛЬНО (REQUIRED в production для hydra_checker; в hydra_api имеет fallback)
# [DEFAULT: http://127.0.0.1:8080]
# Допустимые значения: https://<host>:<port>[/path] или http://<host>:<port>[/path]
JUDGE_HTTPS_URL=http://127.0.0.1:8080

# Статический секретный токен-маркер, ожидаемый в ответе Judge сервера.
# Чекер отправляет его в заголовке `X-Hydra-Token` и параметре `?token=...`,
# а затем валидирует обязательное присутствие этого токена в теле ответа эхо-сервера.
# Отсекает ложные срабатывания (Captive Portals отелей/WiFi, страницы блокировок провайдеров).
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Маркер верификации эхо-ответа и отсева ложных срабатываний
# Тип: String
# Обязательность: ОБЯЗАТЕЛЬНО (REQUIRED в production для hydra_checker; в hydra_api имеет fallback)
# [DEFAULT: hydra_secret_token]
# Допустимые значения: любая криптостойкая или уникальная непустая строка-маркер
JUDGE_SECRET_TOKEN=hydra_secret_token


# ==============================================================================
# 2. НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (OPTIONAL & DEFAULTS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 2.1. Сеть и сервер (Network & Server)
# ------------------------------------------------------------------------------

# Сетевой адрес и TCP-порт для входящих HTTP-запросов REST API и Swagger UI.
# Доступ к интерактивной документации OpenAPI: http://<LISTEN_ADDR>/swagger-ui
# Модуль: API (hydra_api)
# Назначение: Привязка сокета входящих HTTP-соединений REST API
# Тип: SocketAddr
# Обязательность: Опционально
# [DEFAULT: 0.0.0.0:3000]
# Допустимые значения: валидный IP:PORT (IPv4 или IPv6, например 0.0.0.0:3000, 127.0.0.1:3000, [::]:3000)
LISTEN_ADDR=0.0.0.0:3000

# Запуск встроенного фонового инстанса JudgeServer внутри процесса hydra_api
# на порту EMBED_JUDGE_PORT параллельно с REST API (All-In-One режим для разработки).
# Для продакшена рекомендуется false (Judge выносится на отдельный VPS с белым IP).
# Модуль: API (hydra_api)
# Назначение: Управление встроенным инстансом Judge
# Тип: bool
# Обязательность: Опционально
# [DEFAULT: false]
# Допустимые значения: true | false | 1 | 0
EMBED_JUDGE=false

# TCP-порт для прослушивания входящих HTTP-запросов встроенного эхо-сервера Judge при EMBED_JUDGE=true.
# Согласован со значением HTTP_PORT модуля hydra_judge.
# Модуль: API (hydra_api)
# Назначение: TCP-порт встроенного эхо-сервера Judge
# Тип: u16
# Обязательность: Опционально
# [DEFAULT: 8080]
# Допустимые значения: целое число 1..65535
EMBED_JUDGE_PORT=8080

# TCP-порт для входящих незашифрованных HTTP-запросов автономного эхо-сервера Judge (привязка к 0.0.0.0:<HTTP_PORT>).
# Используется при автономном запуске бинарника `hydra_judge` (`cargo run -p hydra_judge`).
# Модуль: Judge (hydra_judge, автономный запуск)
# Назначение: TCP-порт входящих HTTP-запросов автономного Judge
# Тип: u16
# Обязательность: Опционально
# [DEFAULT: 8080]
# Допустимые значения: целое число 1..65535
HTTP_PORT=8080

# TCP-порт для входящих защищенных HTTPS/TLS-запросов автономного эхо-сервера Judge (привязка к 0.0.0.0:<HTTPS_PORT>).
# Если не задан — сервер работает исключительно по протоколу HTTP.
# Если задан без указания путей TLS_CERT_PATH/TLS_KEY_PATH — на лету генерируется самоподписанный TLS-сертификат (rcgen).
# Модуль: Judge (hydra_judge, автономный запуск)
# Назначение: TCP-порт входящих HTTPS/TLS-запросов автономного Judge
# Тип: u16
# Обязательность: Опционально
# [DEFAULT: не задан (HTTPS отключен)]
# Допустимые значения: целое число 1..65535
# HTTPS_PORT=8443

# ------------------------------------------------------------------------------
# 2.2. Хранилище данных (Storage / libSQL)
# ------------------------------------------------------------------------------

# Путь к локальному файлу базы данных libSQL на диске или `:memory:` для in-memory базы.
# Таблицы, схемы и индексы накатываются автоматически при первом запуске в режиме SQLite WAL.
# Директории на диске создаются сервером автоматически.
# Модуль: API (hydra_api)
# Назначение: Расположение файла БД libSQL / SQLite WAL
# Тип: String (Path)
# Обязательность: Опционально
# [DEFAULT: ./data/hydra.db]
# Допустимые значения: относительный или абсолютный путь к файлу .db, либо строка `:memory:`
DB_PATH=./data/hydra.db

# ------------------------------------------------------------------------------
# 2.3. Интеграция с Judge и ядро чекера (Judge Integration & Checker Core)
# ------------------------------------------------------------------------------

# Секретный статический токен для авторизации входящих запросов к автономному эхо-серверу Judge.
# Клиент обязан передать токен через: `?token=...`, path `/<token>` или заголовок `X-Hydra-Token`.
# Активный токен отражается в теле ответа Judge для верификации чекером. Игнорируется, если задан SECRET_KEY.
# Модуль: Judge (hydra_judge, автономный запуск)
# Назначение: Авторизационный токен входящих запросов Judge (Anti-Abuse Token Guard)
# Тип: String
# Обязательность: Опционально
# [DEFAULT: hydra_secret_token]
# Допустимые значения: произвольная непустая строка
SECRET_TOKEN=hydra_secret_token

# Секретный мастер-ключ HMAC-SHA256 для посуточной ротации токенов на стороне автономного Judge.
# При включении токен меняется каждые UTC-сутки. Сервер принимает токены за сегодня (today)
# и вчера (yesterday), предоставляя 24-часовое окно перехода. Должен совпадать с JUDGE_SECRET_KEY в checker/api.
# Модуль: Judge (hydra_judge, автономный запуск)
# Назначение: Мастер-ключ валидации динамических суточных токенов
# Тип: String
# Обязательность: Опционально
# [DEFAULT: не задан (используется статический токен SECRET_TOKEN)]
# Допустимые значения: шестнадцатеричная строка (например, 64 hex-символа) или криптостойкий секрет
# SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Мастер-ключ HMAC-SHA256 для синхронизированной посуточной ротации токенов на стороне чекера.
# Если задан — чекер вместо статического токена генерирует динамический суточный токен ("hydra-token-v1:{epoch_day}").
# Должен совпадать со значением SECRET_KEY на стороне Judge.
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Мастер-ключ генерации динамических суточных токенов
# Тип: String
# Обязательность: Опционально
# [DEFAULT: отсутствует / не задан (используется статический токен JUDGE_SECRET_TOKEN)]
# Допустимые значения: шестнадцатеричная строка (например, 64 hex-символа) или криптостойкий секрет
# JUDGE_SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Поведение эхо-сервера Judge при получении запроса без валидного токена авторизации:
#   - drop_rst : мгновенный жесткий сброс TCP-соединения через SO_LINGER=0 (TCP RST).
#                Не отправляет ни байта ответа, не расходует CPU, маскирует порт от сканеров Shodan/Censys.
#   - http_403 : отправка HTTP-ответа 403 Forbidden с заголовком Connection: close.
# Модуль: Judge (hydra_judge)
# Назначение: Реакция на неавторизованные сетевые запросы
# Тип: Enum (String)
# Обязательность: Опционально
# [DEFAULT: drop_rst]
# Допустимые значения: drop_rst | http_403 (регистронезависимо)
UNAUTHORIZED_ACTION=drop_rst

# Базовый формат вывода отраженных заголовков и метаданных клиента эхо-сервером Judge:
#   - azenv : высокопроизводительный текстовый формат AZenv (REMOTE_ADDR = ..., HTTP_USER_AGENT = ...)
#   - json  : структурированный JSON-формат (origin, headers, token), совместимый с httpbin
# Может переопределяться клиентом динамически через `?format=json` или заголовок `Accept: application/json`.
# Модуль: Judge (hydra_judge)
# Назначение: Формат эхо-ответа по умолчанию
# Тип: Enum (String)
# Обязательность: Опционально
# [DEFAULT: azenv]
# Допустимые значения: azenv | json (регистронезависимо)
FORMAT=azenv

# Путь к файлу открытого X.509 сертификата сервера Judge в формате PEM.
# Параметры TLS_CERT_PATH и TLS_KEY_PATH должны задаваться строго в паре!
# Если не заданы при указанном HTTPS_PORT, Judge генерирует самоподписанный сертификат на лету.
# Модуль: Judge (hydra_judge)
# Назначение: Сертификат открытого ключа X.509 для HTTPS-режима
# Тип: String (Path)
# Обязательность: Опционально
# [DEFAULT: не задан (автогенерация самоподписанного сертификата)]
# Допустимые значения: абсолютный или относительный путь к файлу PEM (.crt / .pem)
# TLS_CERT_PATH=/etc/ssl/certs/judge.crt

# Путь к файлу приватного ключа сервера Judge в формате PEM (PKCS#8).
# Используется строго в паре с параметром TLS_CERT_PATH.
# Модуль: Judge (hydra_judge)
# Назначение: Приватный ключ PKCS#8 для HTTPS-режима
# Тип: String (Path)
# Обязательность: Опционально
# [DEFAULT: не задан (автогенерация самоподписанного сертификата)]
# Допустимые значения: абсолютный или относительный путь к файлу PEM (.key / .pem)
# TLS_KEY_PATH=/etc/ssl/private/judge.key

# Максимальный размер входящего HTTP-запроса к Judge в байтах (включая заголовки).
# В коде действует аппаратный минимум 512 байт (значения < 512 округляются до 512).
# При превышении лимита входящее соединение немедленно сбрасывается.
# Модуль: Judge (hydra_judge)
# Назначение: Лимит объема входящего HTTP-запроса для защиты от атак на переполнение
# Тип: usize
# Обязательность: Опционально
# [DEFAULT: 4096]
# Допустимые значения: целое положительное число байт >= 512
# MAX_REQUEST_BYTES=4096

# Таймаут на полную обработку клиентского соединения к Judge в секундах.
# Ограничивает суммарное время на TLS-хендшейк, чтение HTTP-запроса и отправку ответа (защита от Slowloris).
# Модуль: Judge (hydra_judge)
# Назначение: Таймаут соединения эхо-сервера
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 3]
# Допустимые значения: целое положительное число секунд > 0
# REQUEST_TIMEOUT_SECS=3

# Лимит одновременных активных клиентских соединений к эхо-серверу Judge (семафор защиты от DoS/OOM).
# При исчерпании лимита новые TCP-соединения сбрасываются через TCP RST без аллокаций памяти.
# Модуль: Judge (hydra_judge)
# Назначение: Семафор максимальной одновременной нагрузки на эхо-сервер
# Тип: usize
# Обязательность: Опционально
# [DEFAULT: 10000]
# Допустимые значения: целое положительное число >= 1
# MAX_CONCURRENT_CONNECTIONS=10000

# Максимальное количество одновременно выполняемых сетевых проверок прокси (concurrency limit).
# Ограничивает нагрузку на семафор Tokio, дескрипторы сокетов ОС и оперативную память.
# Значение автоматически приводится к аппаратному минимуму 1.
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Семафор параллельных проверок прокси
# Тип: usize
# Обязательность: Опционально
# [DEFAULT: 5000]
# Допустимые значения: целое положительное число >= 1 (обычно 1000..50000)
CHECKER_CONCURRENCY=5000

# Таймаут на установление L4 TCP-соединения (SYN -> SYN-ACK) с прокси в миллисекундах.
# Позволяет молниеносно отсекать мертвые IP-адреса и закрытые порты до начала протокольной фазы.
# Модуль: Checker (hydra_checker)
# Назначение: Лимит времени на TCP Connect к прокси
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 3000]
# Допустимые значения: целое положительное число миллисекунд >= 1 (обычно 500..10000)
# CHECKER_CONNECT_TIMEOUT_MS=3000

# Таймаут на протокольное рукопожатие туннеля в миллисекундах.
# Включает согласование SOCKS4/SOCKS5, отправку HTTP CONNECT и согласование TLS-сессии.
# Модуль: Checker (hydra_checker)
# Назначение: Лимит времени на протокольный хендшейк
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 4000]
# Допустимые значения: целое положительное число миллисекунд >= 1 (обычно 1000..15000)
# CHECKER_HANDSHAKE_TIMEOUT_MS=4000

# Таймаут на отправку L7 HTTP-запроса через туннель и получение полного ответа от Judge в миллисекундах.
# Модуль: Checker (hydra_checker)
# Назначение: Лимит времени на прием эхо-ответа через прокси
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 5000]
# Допустимые значения: целое положительное число миллисекунд >= 1 (обычно 1000..30000)
# CHECKER_READ_WRITE_TIMEOUT_MS=5000

# Максимальный размер считываемого тела ответа от эхо-сервера в байтах.
# Защищает чекер от атак исчерпания памяти и DoS при попадании на tarpit / endless HTTP stream.
# Модуль: Checker (hydra_checker)
# Назначение: Буферный лимит считывания эхо-ответа
# Тип: usize
# Обязательность: Опционально
# [DEFAULT: 8192]
# Допустимые значения: целое положительное число байт >= 1 (обычно 4096..65536)
# CHECKER_MAX_READ_BYTES=8192

# Принудительная привязка исходящих сокетов чекера к локальному IP сетевого интерфейса (SO_BINDTODEVICE / bind).
# Актуально для серверов с несколькими внешними IP, сетевыми картами или маршрутизацией через VPN.
# Модуль: Checker (hydra_checker)
# Назначение: Привязка исходящего сетевого интерфейса
# Тип: IpAddr
# Обязательность: Опционально
# [DEFAULT: отсутствует (выбор интерфейса определяется таблицей маршрутизации ОС)]
# Допустимые значения: валидный IPv4 или IPv6 адрес сетевого интерфейса хоста (например, 192.168.1.100 или 2001:db8::2)
# CHECKER_LOCAL_BIND_IP=192.168.1.100

# Реальные внешние публичные IP-адреса хоста, на котором запущен чекер/API.
# Критически важен для классификации уровня анонимности прокси:
#   - Transparent : если в эхо-ответе (REMOTE_ADDR, origin, X-Forwarded-For) найден реальный IP хоста.
#   - Anonymous   : если реальный IP скрыт, но прокси сообщает о себе через заголовки Via/Proxy-*.
#   - Elite       : если реальный IP скрыт и прокси не добавляет никаких идентификационных заголовков.
# Также используется для фильтрации Bogon/SSRF и предотвращения случайного сканирования своей инфраструктуры.
#
# Если параметр не задан (закомментирован или пуст), чекер автоматически динамически
# определяет сетевую идентичность (HostIdentity): собирает адреса локальных сетевых интерфейсов
# хоста (публичные IPv4, IPv6 и вычисляет /64 подсети), а также дополняет их внешними IP
# через опрос судей (что корректно пробивает NAT/Docker).
# Статическое указание CHECKER_REAL_IPS (или алиаса CHECKER_REAL_IP) переопределяет автодетект.
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Публичные IP хоста чекера для классификации анонимности
# Тип: String (IP или список IP / CIDR)
# Обязательность: Опционально
# [DEFAULT: отсутствует (активируется автоматический композитный детект через интерфейсы и судей)]
# Допустимые значения: одиночный IP или список IP и CIDR-подсетей через запятую (например, 203.0.113.195, 2001:db8::/64)
# CHECKER_REAL_IPS=203.0.113.195, 2001:db8::/64
# CHECKER_REAL_IP=203.0.113.195

# ------------------------------------------------------------------------------
# 2.4. Пул судей, мониторинг доступности и стратегия выбора (Judge Pool & Health Checks)
# ------------------------------------------------------------------------------

# Включение встроенного/основного судьи (из JUDGE_HTTP_URL / JUDGE_HTTPS_URL) в пул проверок.
# Если true — основной судья регистрируется в пуле с наивысшим приоритетом 0.
# Если false — основной судья исключается из ротации (полезно при тестировании только через сторонних судей).
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Регистрация основного судьи в пуле
# Тип: bool
# Обязательность: Опционально
# [DEFAULT: true в hydra_checker; auto (true если EMBED_JUDGE=true или JUDGE_HTTP_URL != http://127.0.0.1:8080) в hydra_api]
# Допустимые значения: true | false | 1 | 0
# ENABLE_BUILTIN_JUDGE=false

# Включение проверенного пула публичных сторонних судей (Httpbingo, Httpbin, Httpbun, AZenv, ProxyJudge, Cloudflare, Ipify).
# При падении или деградации основного Judge чекер мгновенно переключается на здоровых судей из пула.
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Резервный пул публичных эхо-серверов
# Тип: bool
# Обязательность: Опционально
# [DEFAULT: true]
# Допустимые значения: true | false | 1 | 0
ENABLE_THIRD_PARTY_JUDGES=true

# Интервал периодической фоновой проверки доступности (Health Check) судей в пуле (в секундах).
# Фоновый воркер опрашивает всех зарегистрированных судей, замеряет RTT EMA и статус доступности.
# Судьи с 2 последовательными ошибками временно исключаются из маршрутизации проверок.
# Модуль: API (hydra_api)
# Назначение: Периодичность опроса здоровья пула судей
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 30]
# Допустимые значения: целое положительное число секунд > 0
JUDGE_HEALTH_CHECK_INTERVAL_SECS=30

# Стратегия распределения проверок по пулу доступных и здоровых судей:
#   - lowest_latency (или latency) : выбирать судью с наименьшим измеренным временем ответа (RTT EMA) (рекомендуется)
#   - priority                     : всегда использовать судью с наивысшим приоритетом (основной/встроенный),
#                                    переключаясь на резервных только при обнаружении сбоев
#   - round_robin (или roundrobin) : циклическое равномерное распределение запросов по кругу
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Алгоритм балансировки проверок между эхо-серверами
# Тип: Enum (String)
# Обязательность: Опционально
# [DEFAULT: lowest_latency]
# Допустимые значения: lowest_latency | latency | priority | round_robin | roundrobin
JUDGE_SELECTION_STRATEGY=lowest_latency

# Дополнительные пользовательские сторонние судьи через запятую.
# Позволяет подключать собственные или приватные эхо-серверы (AZenv PHP, Go/Python echo judge).
# Формат пары: HTTP_URL|HTTPS_URL,HTTP_URL|HTTPS_URL... (или просто HTTP_URL, если HTTPS идентичен).
# Модуль: Checker / API (hydra_checker, hydra_api)
# Назначение: Подключение пользовательских серверов Judge
# Тип: String
# Обязательность: Опционально
# [DEFAULT: отсутствует (пустой список)]
# Допустимые значения: строка валидных URL, разделенных вертикальной чертой и запятыми
# ADDITIONAL_JUDGES=http://judge1.example.com/azenv.php|https://judge1.example.com/azenv.php,http://judge2.example.com/get

# ------------------------------------------------------------------------------
# 2.5. Гео-обогащение MaxMind GeoLite2 & Автообновление (GeoIP)
# ------------------------------------------------------------------------------

# Включение автоматической фоновой загрузки и регулярного обновления баз MaxMind GeoLite2 из CDN.
# Используется зеркало wp-statistics/geo (jsDelivr CDN) с проверкой условных заголовков ETag / 304 Not Modified.
# Модуль: API (hydra_api)
# Назначение: Автоматическая синхронизация GeoIP баз
# Тип: bool
# Обязательность: Опционально
# [DEFAULT: true]
# Допустимые значения: true | false | 1 | 0
GEOIP_AUTO_UPDATE=true

# Локальный путь к файлу базы данных стран MaxMind GeoLite2-Country .mmdb на диске.
# Если GEOIP_AUTO_UPDATE=true и путь не задан, автоматически используется ./geo/GeoLite2-Country.mmdb.
# Если файл отсутствует, сервер продолжает работу с полями country=NULL.
# Модуль: API (hydra_api)
# Назначение: Путь к локальной базе GeoLite2 Country
# Тип: String (Path)
# Обязательность: Опционально
# [DEFAULT: ./geo/GeoLite2-Country.mmdb при GEOIP_AUTO_UPDATE=true, иначе отсутствует]
# Допустимые значения: относительный или абсолютный путь к файлу .mmdb
# GEOIP_COUNTRY_PATH=./geo/GeoLite2-Country.mmdb

# Локальный путь к файлу базы данных автономных систем MaxMind GeoLite2-ASN .mmdb на диске.
# Если GEOIP_AUTO_UPDATE=true и путь не задан, автоматически используется ./geo/GeoLite2-ASN.mmdb.
# Если файл отсутствует, сервер продолжает работу с полями asn=NULL.
# Модуль: API (hydra_api)
# Назначение: Путь к локальной базе GeoLite2 ASN
# Тип: String (Path)
# Обязательность: Опционально
# [DEFAULT: ./geo/GeoLite2-ASN.mmdb при GEOIP_AUTO_UPDATE=true, иначе отсутствует]
# Допустимые значения: относительный или абсолютный путь к файлу .mmdb
# GEOIP_ASN_PATH=./geo/GeoLite2-ASN.mmdb

# Период проверки и горячей перечитки файлов баз с диска (в секундах).
# Позволяет обновлять .mmdb файлы на лету без перезапуска сервиса hydra_api.
# Модуль: API (hydra_api)
# Назначение: Интервал горячей перезагрузки баз с диска
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 3600 (1 час)]
# Допустимые значения: целое положительное число секунд > 0
GEOIP_RELOAD_SECS=3600

# Интервал проверки наличия обновлений в удаленном CDN зеркале (в секундах).
# Модуль: API (hydra_api)
# Назначение: Интервал проверки свежих релизов баз в CDN
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 86400 (24 часа)]
# Допустимые значения: целое положительное число секунд > 0
GEOIP_UPDATE_INTERVAL_SECS=86400

# URL-адреса CDN зеркал для скачивания архивов .mmdb.gz (или прямых .mmdb).
# Модуль: API (hydra_api)
# Назначение: Источники загрузки GeoIP архивов
# Тип: String (URL)
# Обязательность: Опционально
# [DEFAULT: https://cdn.jsdelivr.net/npm/geolite2-country/GeoLite2-Country.mmdb.gz]
GEOIP_COUNTRY_URL=https://cdn.jsdelivr.net/npm/geolite2-country/GeoLite2-Country.mmdb.gz
# [DEFAULT: https://cdn.jsdelivr.net/npm/geolite2-asn/GeoLite2-ASN.mmdb.gz]
GEOIP_ASN_URL=https://cdn.jsdelivr.net/npm/geolite2-asn/GeoLite2-ASN.mmdb.gz

# ------------------------------------------------------------------------------
# 2.6. Планировщик (Scheduler) и пакетная запись (Batch Writer)
# ------------------------------------------------------------------------------

# Максимальное количество созревших прокси, выбираемых планировщиком каждую секунду
# для постановки в конвейер сетевой проверки (limit выборки по next_check_at <= now).
# Модуль: API (hydra_api)
# Назначение: Размер ежесекундного батча созревших прокси
# Тип: usize
# Обязательность: Опционально
# [DEFAULT: 10000]
# Допустимые значения: целое положительное число > 0
SCHEDULER_BATCH_SIZE=10000

# Интервал сброса буфера результатов проверок из памяти в базу данных (в миллисекундах).
# Результаты проверок накапливаются в MPSC-канале и сбрасываются пакетом в единой транзакции.
# Модуль: API (hydra_api)
# Назначение: Частота периодического пакетного сброса результатов проверок в БД
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 100]
# Допустимые значения: целое положительное число миллисекунд > 0
BATCH_FLUSH_INTERVAL_MS=100

# ------------------------------------------------------------------------------
# 2.7. Обслуживание базы данных и очистка мертвых прокси (Database Maintenance & Retention)
# ------------------------------------------------------------------------------

# Срок хранения окончательно мертвых прокси (dead_permanent) в днях.
# По истечении этого срока они автоматически удаляются фоновым процессом обслуживания.
# Модуль: API (hydra_api)
# Назначение: Срок удержания устаревших нерабочих прокси
# Тип: u32
# Обязательность: Опционально
# [DEFAULT: 30]
# Допустимые значения: целое положительное число дней > 0
DEAD_PROXY_RETENTION_DAYS=30

# Интервал регулярного фонового обслуживания базы данных (в секундах).
# Включает удаление старых dead_permanent, неблокирующий чекпоинт WAL (PRAGMA wal_checkpoint(PASSIVE)),
# дефрагментацию страниц (incremental_vacuum) и оптимизацию статистики индексов (PRAGMA optimize).
# Модуль: API (hydra_api)
# Назначение: Интервал периодического фонового регламента SQLite WAL
# Тип: u64
# Обязательность: Опционально
# [DEFAULT: 3600 (1 час)]
# Допустимые значения: целое положительное число секунд > 0
DB_MAINTENANCE_INTERVAL_SECS=3600

# ------------------------------------------------------------------------------
# 2.8. Логирование и трассировка (Logging & Tracing)
# ------------------------------------------------------------------------------

# Уровень детализации системного журнала и событий трассировки через tracing / tracing-subscriber.
# Поддерживает стандартный синтаксис директив EnvFilter: error, warn, info, debug, trace с фильтрацией по модулям.
# Модуль: Core / Все модули (hydra_api, hydra_judge, hydra_checker)
# Назначение: Фильтр вывода структурированных логов и трассировок
# Тип: String
# Обязательность: Опционально
# [DEFAULT: info,hydra_api=debug,hydra_judge=debug (в hydra_api); info,hydra_checker=debug (в hydra_checker); info (в hydra_judge)]
# Допустимые значения: error | warn | info | debug | trace, либо список директив target=level
RUST_LOG=info,hydra_api=debug,hydra_checker=info,hydra_judge=info
