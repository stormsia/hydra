# ==============================================================================
# Hydra Proxy System — Полный эталонный конфигурационный файл (.env.example)
# Поддерживает настройку всех модулей воркспейса:
#   - hydra_api     (REST API, Swagger UI, планировщик, пакетный буфер, GeoIP)
#   - hydra_judge   (Авторизованный L7 Echo-сервер для валидации прокси)
#   - hydra_checker (Высокопроизводительное асинхронное ядро сетевых проверок)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Сервер (hydra_api)
# ------------------------------------------------------------------------------
# Сетевой адрес и TCP-порт для входящих HTTP-запросов REST API и Swagger UI.
# Формат: IP:PORT (например, 0.0.0.0:3000 или 127.0.0.1:3000).
# По умолчанию: 0.0.0.0:3000
# Обязательность: Опционально (при отсутствии используется значение по умолчанию)
LISTEN_ADDR=0.0.0.0:3000

# Секретный мастер-ключ для авторизации запросов к REST API.
# Передается клиентом в HTTP-заголовке `X-API-Key: <значение>`.
# Формат: любая криптостойкая произвольная строка (рекомендуется от 32 символов).
# По умолчанию: отсутствует (сервер не запустится без этого параметра).
# Обязательность: ОБЯЗАТЕЛЬНО
API_KEY=hydra_super_secret_api_key_change_me_in_production

# ------------------------------------------------------------------------------
# 2. Локальное хранилище данных (libSQL / SQLite WAL)
# ------------------------------------------------------------------------------
# Путь к локальному файлу базы данных libSQL на диске.
# Движок автоматически создает необходимые таблицы и индексы в режиме WAL.
# Формат: относительный или абсолютный путь к файлу .db.
# По умолчанию: ./data/hydra.db
# Обязательность: Опционально
DB_PATH=./data/hydra.db

# ------------------------------------------------------------------------------
# 3. Встроенный Echo-сервер Judge (All-In-One режим для локальной разработки)
# ------------------------------------------------------------------------------
# Если true — hydra_api автоматически запускает внутренний фоновый инстанс
# JudgeServer на порту EMBED_JUDGE_PORT параллельно с REST API.
# Для продакшена рекомендуется false (Judge размещается на отдельном сервере с белым IP).
# Формат: true | false | 1 | 0
# По умолчанию: false
# Обязательность: Опционально
EMBED_JUDGE=false

# TCP-порт для прослушивания входящих HTTP-запросов встроенного Judge.
# Формат: целое число 1..65535.
# По умолчанию: 8080
# Обязательность: Опционально
EMBED_JUDGE_PORT=8080

# ------------------------------------------------------------------------------
# 4. Ядро чекера (hydra_checker core)
# ------------------------------------------------------------------------------
# Базовый HTTP URL эхо-сервера Judge для проверки незашифрованного HTTP прокси-трафика.
# Допускает явную подстановку `{TOKEN}` в пути (например: http://127.0.0.1:8080/{TOKEN}).
# При отсутствии плейсхолдера токен автоматически передается в query `?token=...`.
# Формат: http://<host>:<port>[/path]
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTP_URL=http://127.0.0.1:8080

# Базовый HTTPS URL эхо-сервера Judge для проверки туннелирования (CONNECT, SOCKS4/5).
# Допускает явную подстановку `{TOKEN}` в пути (например: https://127.0.0.1:8080/{TOKEN}).
# При отсутствии плейсхолдера токен автоматически передается в query `?token=...`.
# Формат: https://<host>:<port>[/path] или http://...
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTPS_URL=http://127.0.0.1:8080

# Статический секретный токен для верификации ответа Judge и отсева сканеров.
# Должен совпадать со значением SECRET_TOKEN на сервере Judge.
# Формат: строка
# По умолчанию: hydra_secret_token
# Обязательность: Опционально
JUDGE_SECRET_TOKEN=hydra_secret_token

# Мастер-ключ для синхронизированной посуточной ротации токенов по HMAC-SHA256.
# Если задан — заменяет статический токен динамическим 32-символьным hex-токеном ("hydra-token-v1:{epoch_day}").
# Сервер Judge принимает токены за сегодня (today) и вчера (yesterday), предоставляя полное 24-часовое окно перехода.
# Должен совпадать с SECRET_KEY на сервере Judge.
# Формат: шестнадцатеричная строка или криптостойкий секрет (например, 64 hex chars).
# По умолчанию: не задан (используется статический JUDGE_SECRET_TOKEN)
# Обязательность: Опционально
# JUDGE_SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# ------------------------------------------------------------------------------
# 4.1. Пул сторонних судей, чек доступности и фаллбеки (Third-Party Judges & Health Checks)
# ------------------------------------------------------------------------------
# Включение пула проверенных сторонних стабильных судей (AZenv.net, ProxyJudge.us, Httpbin.org, Cloudflare Trace, Ipify.org).
# При падении или недоступности встроенного/основного судьи чекер автоматически переключается на здоровых сторонних судей.
# Формат: true | false | 1 | 0
# По умолчанию: true
# Обязательность: Опционально
ENABLE_THIRD_PARTY_JUDGES=true

# Периодичность автоматической проверки доступности (Health Check) судей в секундах.
# Фоновый воркер опрашивает всех зарегистрированных судей, измеряет задержку (RTT) и валидирует корректность ответа.
# При 2 последовательных сбоях судья помечается как unhealthy и временно исключается из маршрутизации.
# Формат: целое число секунд (> 0).
# По умолчанию: 30
# Обязательность: Опционально
JUDGE_HEALTH_CHECK_INTERVAL_SECS=30

# Стратегия выбора судьи из пула доступных и здоровых:
#   - lowest_latency: автоматически выбирать судью с минимальным измеренным RTT (рекомендуется)
#   - priority      : выбирать первого доступного судью по номеру приоритета (основной -> AZenv -> ProxyJudge -> ...)
#   - round_robin   : циклически распределять проверки по очереди между всеми доступными судьями
# Формат: lowest_latency | priority | round_robin (или roundrobin)
# По умолчанию: lowest_latency
# Обязательность: Опционально
JUDGE_SELECTION_STRATEGY=lowest_latency

# Дополнительные пользовательские сторонние судьи через запятую.
# Формат: HTTP_URL|HTTPS_URL,HTTP_URL|HTTPS_URL...
# По умолчанию: не задано (используются встроенный + стандартный стабильный пул)
# Обязательность: Опционально
# ADDITIONAL_JUDGES=http://myjudge.example.com/azenv.php|https://myjudge.example.com/azenv.php

# Лимит одновременно выполняемых параллельных сетевых проверок прокси.
# Ограничивает нагрузку на сеть, дескрипторы сокетов и оперативную память.
# Формат: целое положительное число (> 0).
# По умолчанию: 5000
# Обязательность: Опционально
CHECKER_CONCURRENCY=5000

# Таймаут на установление TCP-соединения (SYN -> SYN-ACK) с прокси (в миллисекундах).
# Формат: целое число миллисекунд.
# По умолчанию: 3000 (3 секунды)
# Обязательность: Опционально
# CHECKER_CONNECT_TIMEOUT_MS=3000

# Таймаут на согласование протокола туннеля (SOCKS-рукопожатие, CONNECT, TLS) (в мс).
# Формат: целое число миллисекунд.
# По умолчанию: 4000 (4 секунды)
# Обязательность: Опционально
# CHECKER_HANDSHAKE_TIMEOUT_MS=4000

# Таймаут на отправку запроса и чтение эхо-ответа через прокси (в миллисекундах).
# Формат: целое число миллисекунд.
# По умолчанию: 5000 (5 секунд)
# Обязательность: Опционально
# CHECKER_READ_WRITE_TIMEOUT_MS=5000

# Максимальный объем читаемого ответа от эхо-сервера в байтах (защита от memory tarpit).
# Формат: целое число байт.
# По умолчанию: 8192 (8 КБ)
# Обязательность: Опционально
# CHECKER_MAX_READ_BYTES=8192

# Привязка исходящих сокетов к определенному локальному IP сетевого интерфейса.
# Актуально для многодомовых серверов (multi-homed) с несколькими белыми IP.
# Формат: IPv4 или IPv6 адрес (например, 192.168.1.50).
# По умолчанию: отсутствует (выбирается ОС автоматически)
# Обязательность: Опционально
# CHECKER_LOCAL_BIND_IP=192.168.1.50

# Реальный внешний публичный IP адрес сервера, на котором запущен чекер.
# Используется для точной классификации прозрачных (Transparent) прокси,
# определяя факт утечки исходного IP в заголовках `REMOTE_ADDR` или `X-Forwarded-For`.
# Формат: IPv4 или IPv6 адрес (например, 203.0.113.195).
# По умолчанию: отсутствует (авто-классификация только по явным заголовкам)
# Обязательность: Опционально
# CHECKER_REAL_IP=203.0.113.195

# ------------------------------------------------------------------------------
# 5. Автономный Echo-сервер Judge (для запуска `cargo run -p hydra_judge`)
# ------------------------------------------------------------------------------
# Порт для входящих незашифрованных HTTP-запросов эхо-сервера Judge.
# Формат: целое число 1..65535.
# По умолчанию: 8080
# Обязательность: Опционально
HTTP_PORT=8080

# Порт для защищенных входящих HTTPS/TLS-запросов эхо-сервера Judge.
# Если не задан — сервер слушает только незашифрованный HTTP.
# Если задан, но сертификаты не указаны — автоматически создается самоподписанный TLS.
# Формат: целое число 1..65535.
# По умолчанию: не задан (HTTPS отключен)
# Обязательность: Опционально
# HTTPS_PORT=8443

# Секретный статический токен для валидации входящих запросов к автономному Judge.
# Клиент обязан передать токен в URL query `?token=...`, path `/token/...` или `X-Hydra-Token`.
# Формат: строка
# По умолчанию: hydra_secret_token
# Обязательность: Опционально
SECRET_TOKEN=hydra_secret_token

# Секретный ключ HMAC-SHA256 для посуточной ротации токенов на стороне автономного Judge.
# При включении статический токен заменяется на динамический, пересчитываемый посуточно.
# Формат: шестнадцатеричная строка или секретная фраза.
# По умолчанию: не задан (используется статический SECRET_TOKEN)
# Обязательность: Опционально
# SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Формат выдачи тела эхо-ответа сервером:
#   - `azenv` : сверхбыстрый плоский текстовый формат переменных окружения (REMOTE_ADDR = ...)
#   - `json`  : структурированный JSON формат, совместимый с httpbin
# Формат: azenv | json
# По умолчанию: azenv
# Обязательность: Опционально
FORMAT=azenv

# Поведение сервера при получении запроса без валидного токена (защита от сканеров Censys/Shodan):
#   - `drop_rst` : мгновенный разрыв TCP-соединения через SO_LINGER=0 (0 байт ответа, 0 CPU)
#   - `http_403` : отправка стандартного ответа HTTP 403 Forbidden с Connection: close
# Формат: drop_rst | http_403
# По умолчанию: drop_rst
# Обязательность: Опционально
UNAUTHORIZED_ACTION=drop_rst

# Пути к файлам X.509 PEM TLS сертификата и приватного ключа для HTTPS-режима Judge.
# Если не заданы при указанном HTTPS_PORT, Judge генерирует самоподписанный сертификат на лету.
# Формат: пути к файлам PEM.
# По умолчанию: не заданы
# Обязательность: Опционально
# TLS_CERT_PATH=/etc/ssl/certs/judge.crt
# TLS_KEY_PATH=/etc/ssl/private/judge.key

# Максимальный размер входящего HTTP-запроса к Judge в байтах.
# Формат: целое число байт (минимум 512).
# По умолчанию: 4096 (4 КБ)
# Обязательность: Опционально
# MAX_REQUEST_BYTES=4096

# Таймаут на обработку входящего запроса к Judge в секундах.
# Формат: целое число секунд.
# По умолчанию: 3
# Обязательность: Опционально
# REQUEST_TIMEOUT_SECS=3

# Максимальное количество одновременных активных соединений к Judge (семафор защиты от DoS/OOM).
# Формат: целое число (> 0).
# По умолчанию: 10000
# Обязательность: Опционально
# MAX_CONCURRENT_CONNECTIONS=10000

# ------------------------------------------------------------------------------
# 6. Гео-обогащение MaxMind GeoLite2 & Автообновление (Опционально)
# ------------------------------------------------------------------------------
# Автоматическая фоновая загрузка и регулярное обновление баз MaxMind GeoLite2 из CDN.
# Используется зеркало wp-statistics/geo (jsDelivr), обновляемое MaxMind дважды в неделю.
# Поддерживает условные HTTP-запросы ETag / 304 Not Modified (нулевой паразитный трафик).
# Формат: true | false | 1 | 0
# По умолчанию: true
# Обязательность: Опционально
GEOIP_AUTO_UPDATE=true

# Локальные пути к файлам баз MaxMind .mmdb на диске.
# Если GEOIP_AUTO_UPDATE=true и пути не заданы, автоматически используются:
#   GEOIP_COUNTRY_PATH=./geo/GeoLite2-Country.mmdb
#   GEOIP_ASN_PATH=./geo/GeoLite2-ASN.mmdb
# Если файлы отсутствуют, сервер продолжает работу с полями country=NULL, asn=NULL.
# Формат: пути к файлам на диске.
# По умолчанию: не заданы (или ./geo/GeoLite2-*.mmdb при автообновлении)
# Обязательность: Опционально
# GEOIP_COUNTRY_PATH=./geo/GeoLite2-Country.mmdb
# GEOIP_ASN_PATH=./geo/GeoLite2-ASN.mmdb

# Период проверки и горячей перечитки файлов баз с локального диска (в секундах).
# Позволяет подменять .mmdb файлы на лету без перезапуска процесса hydra_api.
# Формат: целое число секунд.
# По умолчанию: 3600 (1 час)
# Обязательность: Опционально
GEOIP_RELOAD_SECS=3600

# Интервал проверки наличия свежих баз в удаленном CDN-зеркале (в секундах).
# Формат: целое число секунд.
# По умолчанию: 86400 (24 часа)
# Обязательность: Опционально
GEOIP_UPDATE_INTERVAL_SECS=86400

# URL-адреса CDN-зеркал для скачивания архивов .mmdb.gz (или прямых .mmdb).
# Формат: валидный HTTPS URL.
# По умолчанию: зеркало jsDelivr geolite2
# Обязательность: Опционально
GEOIP_COUNTRY_URL=https://cdn.jsdelivr.net/npm/geolite2-country/GeoLite2-Country.mmdb.gz
GEOIP_ASN_URL=https://cdn.jsdelivr.net/npm/geolite2-asn/GeoLite2-ASN.mmdb.gz

# ------------------------------------------------------------------------------
# 7. Планировщик (Scheduler) и пакетная запись (Batch Writer)
# ------------------------------------------------------------------------------
# Максимальное число прокси, выбираемых планировщиком из БД за одну секунду
# для передачи в рабочий конвейер чекера (limit созревших прокси по next_check_at).
# Формат: целое число (> 0).
# По умолчанию: 10000
# Обязательность: Опционально
SCHEDULER_BATCH_SIZE=10000

# Интервал сброса буфера результатов проверок из памяти в базу данных (в миллисекундах).
# Результаты накапливаются в очереди MPSC и сохраняются единой транзакцией.
# Формат: целое число миллисекунд.
# По умолчанию: 100 (100 миллисекунд)
# Обязательность: Опционально
BATCH_FLUSH_INTERVAL_MS=100

# ------------------------------------------------------------------------------
# 8. Обслуживание базы данных и очистка мертвых прокси
# ------------------------------------------------------------------------------
# Срок хранения окончательно мертвых прокси (dead_permanent) в днях.
# Прокси в статусе dead_permanent, последняя проверка которых была старше этого срока,
# автоматически удаляются из базы данных фоновым процессом обслуживания.
# Формат: целое число дней (> 0).
# По умолчанию: 30 (30 дней)
# Обязательность: Опционально
DEAD_PROXY_RETENTION_DAYS=30

# Интервал регулярного фонового обслуживания базы данных (в секундах).
# Включает удаление устаревших dead_permanent прокси, очистку осиротевших связей,
# неблокирующий сброс WAL-страниц (PRAGMA wal_checkpoint(PASSIVE)),
# дефрагментацию страниц (incremental_vacuum) и оптимизацию статистики индексов (PRAGMA optimize).
# Формат: целое число секунд.
# По умолчанию: 3600 (1 час)
# Обязательность: Опционально
DB_MAINTENANCE_INTERVAL_SECS=3600

# ------------------------------------------------------------------------------
# 9. Логирование и трассировка (tracing / RUST_LOG)
# ------------------------------------------------------------------------------
# Уровень детализации системного журнала и событий трассировки.
# Поддерживает стандартный синтаксис директив EnvFilter:
# `error`, `warn`, `info`, `debug`, `trace` с фильтрацией по модулям.
# Формат: строка фильтра tracing-subscriber.
# По умолчанию в коде: info,hydra_api=debug,hydra_judge=debug
# Обязательность: Опционально
RUST_LOG=info,hydra_api=debug,hydra_checker=info,hydra_judge=info
