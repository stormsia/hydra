# ==============================================================================
# Hydra Checker Core — Полный конфигурационный файл окружения (.env.example)
# Модуль: hydra_checker (Высокопроизводительное асинхронное ядро сетевых проверок L4/L7)
# Используется при автономных тестах, бенчмарках, микросервисах и инициализации CheckerConfig::from_env()
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Адресация и эндпоинты основного Judge сервера
# ------------------------------------------------------------------------------
# Базовый HTTP URL сервера Judge для проверки незашифрованного HTTP трафика (Plain HTTP).
# Используется для прямого HTTP GET запроса через прокси. Чекер автоматически подставляет
# токен в query-параметр ?token=... или заменяет плейсхолдер {TOKEN}, а также выполняет
# асинхронный DNS-предрезолвинг хоста для избежания накладных расходов в цикле проверок.
# Формат: http://<host>:<port>[/path]
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTP_URL=http://127.0.0.1:8080

# Базовый HTTPS URL сервера Judge для проверки защищенных туннелей.
# Применяется при тестировании туннелирования: HTTP CONNECT, SOCKS4/4a и SOCKS5.
# Чекер выполняет предрезолвинг IP-адреса хоста для чистых IPv4 SOCKS4 проверок
# и кэширует предсформированный TLS HTTP-запрос для исключения аллокаций.
# Формат: https://<host>:<port>[/path] или http://<host>:<port>[/path]
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTPS_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 2. Аутентификация и валидация эхо-маркера (Token Verification)
# ------------------------------------------------------------------------------
# Статический секретный токен / маркер, ожидаемый в ответе Judge сервера.
# Чекер отправляет его в заголовке `X-Hydra-Token` и параметре `?token=...`,
# а затем валидирует обязательное присутствие этого токена в теле ответа эхо-сервера.
# Отсекает ложные срабатывания (WiFi Captive Portals, страницы провайдеров, блокировки РКН).
# Формат: произвольная строка
# По умолчанию: hydra_secret_token
# Обязательность: Опционально
JUDGE_SECRET_TOKEN=hydra_secret_token

# Мастер-ключ HMAC-SHA256 для синхронизированной посуточной ротации токенов.
# Если параметр задан — вместо статического токена используется динамический суточный токен,
# вычисляемый детерминированно из HMAC(epoch_day) с 30-минутным окном допуска в полночь (UTC).
# Должен совпадать со значением SECRET_KEY / JUDGE_SECRET_KEY на сервере Judge.
# Формат: криптостойкий секрет или 64-значный hex (например, sha256).
# По умолчанию: не задан (используется статический JUDGE_SECRET_TOKEN)
# Обязательность: Опционально
# JUDGE_SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# ------------------------------------------------------------------------------
# 3. Пул судей и стратегия выбора (Judges & Pool Selection)
# ------------------------------------------------------------------------------
# Включение встроенного/основного судьи (builtin) в пул проверок.
# Если true — встроенный судья регистрируется с приоритетом 0.
# Если false — встроенный судья полностью исключается из маршрутизации и фонового опроса.
# Формат: true | false | 1 | 0
# По умолчанию: true (в автономном режиме hydra_checker)
# Обязательность: Опционально
# ENABLE_BUILTIN_JUDGE=true

# Включение пула проверенных сторонних резервных судей.
# При включении чекер регистрирует стабильные HTTPS-совместимые сторонние эхо-серверы:
#   - Httpbingo.org (приоритет 1)
#   - Httpbin.rs    (приоритет 2)
#   - Httpbun.com   (приоритет 3)
#   - Httpbin.org   (приоритет 4)
#   - Httpbin.dev   (приоритет 5)
# При падении основного Judge чекер мгновенно и прозрачно переключается на здоровых судей.
# Формат: true | false | 1 | 0
# По умолчанию: true
# Обязательность: Опционально
ENABLE_THIRD_PARTY_JUDGES=true

# Стратегия распределения проверок по пулу доступных судей:
#   - lowest_latency (или latency) : выбирать судью с наименьшим измеренным RTT
#   - priority                     : всегда использовать приоритетного судью (основной/встроенный),
#                                    переключаясь на резервных только при сбоях
#   - round_robin (или roundrobin) : циклическое равномерное распределение по кругу
# Формат: lowest_latency | priority | round_robin
# По умолчанию: lowest_latency
# Обязательность: Опционально
JUDGE_SELECTION_STRATEGY=lowest_latency

# Дополнительные пользовательские сторонние судьи через запятую.
# Позволяет подключать собственные или приватные эхо-серверы (AZenv, PHP judge, custom echo).
# Формат: HTTP_URL|HTTPS_URL,HTTP_URL|HTTPS_URL... (или просто HTTP_URL, если HTTPS идентичен).
# По умолчанию: не задано (используются только встроенный и стандартный сторонний пул)
# Обязательность: Опционально
# ADDITIONAL_JUDGES=http://judge1.example.com/azenv.php|https://judge1.example.com/azenv.php,http://judge2.example.com/get

# ------------------------------------------------------------------------------
# 4. Параллелизм и таймауты сетевого конвейера
# ------------------------------------------------------------------------------
# Максимальное количество одновременно выполняемых сетевых проверок (concurrency limit).
# Ограничивает нагрузку на дескрипторы сокетов ОС, семафор Tokio и оперативную память.
# Значение автоматически приводится к минимуму 1.
# Формат: положительное целое число (> 0).
# По умолчанию: 5000
# Обязательность: Опционально
CHECKER_CONCURRENCY=5000

# Таймаут на установление L4 TCP-соединения (SYN -> SYN-ACK) с прокси (в миллисекундах).
# Позволяет молниеносно отсекать мертвые IP-адреса и закрытые порты до начала протокольной фазы.
# Формат: целое число миллисекунд (u64).
# По умолчанию: 3000 (3 секунды)
# Обязательность: Опционально
CHECKER_CONNECT_TIMEOUT_MS=3000

# Таймаут на протокольное рукопожатие туннеля (в миллисекундах).
# Включает согласование SOCKS4/SOCKS5, отправку HTTP CONNECT и согласование TLS-сессии.
# Формат: целое число миллисекунд (u64).
# По умолчанию: 4000 (4 секунды)
# Обязательность: Опционально
CHECKER_HANDSHAKE_TIMEOUT_MS=4000

# Таймаут на отправку L7 HTTP-запроса через туннель и получение полного ответа от Judge (в мс).
# Формат: целое число миллисекунд (u64).
# По умолчанию: 5000 (5 секунд)
# Обязательность: Опционально
CHECKER_READ_WRITE_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 5. Сетевая маршрутизация, безопасность и детекция анонимности
# ------------------------------------------------------------------------------
# Максимальный размер считываемого тела ответа от эхо-сервера в байтах.
# Защищает чекер от атак переполнения памяти и DoS при попадании на tarpit/endless stream.
# Значение автоматически приводится к минимуму 1 байт.
# Формат: целое число байт (usize).
# По умолчанию: 8192 (8 КБ)
# Обязательность: Опционально
CHECKER_MAX_READ_BYTES=8192

# Принудительная привязка исходящих сокетов чекера к локальному IP сетевого интерфейса (SO_BINDTODEVICE / bind).
# Актуально для серверов с несколькими внешними IP, несколькими сетевыми картами или маршрутизацией через VPN.
# Формат: валидный IPv4 или IPv6 адрес (например, 192.168.1.100).
# По умолчанию: отсутствует (выбор интерфейса возлагается на системную таблицу маршрутизации ОС)
# Обязательность: Опционально
# CHECKER_LOCAL_BIND_IP=192.168.1.100

# Реальный внешний публичный IP-адрес хоста, на котором выполняется проверка.
# Критически важен для классификации уровня анонимности прокси:
#   - Transparent : если в эхо-ответе (REMOTE_ADDR, origin, X-Forwarded-For) найден этот IP.
#   - Anonymous   : если реальный IP скрыт, но прокси сообщает о себе через Via/Proxy-* заголовки.
#   - Elite       : если реальный IP скрыт и прокси не добавляет никаких идентификационных заголовков.
# Также предотвращает случайное самосканирование и сканирование локальной инфраструктуры.
#
# Если параметр не задан (закомментирован или пуст), чекер автоматически динамически
# определяет сетевую идентичность (HostIdentity): собирает адреса локальных сетевых интерфейсов
# хоста (публичные IPv4, IPv6 и вычисляет /64 подсети), а также дополняет их внешними IP
# через опрос судей (что пробивает NAT/Docker).
# Статическое указание CHECKER_REAL_IPS (или CHECKER_REAL_IP) является опциональным и переопределяет автодетект.
#
# Формат: одиночный IP или список IP и CIDR-подсетей через запятую:
# например: 203.0.113.195, 198.51.100.42, 2001:db8:cafe::/64
# По умолчанию: композитный автодетект (интерфейсы хоста + консенсус судей)
# Обязательность: Опционально
# CHECKER_REAL_IPS=203.0.113.195, 2001:db8::/64
# CHECKER_REAL_IP=203.0.113.195

# ------------------------------------------------------------------------------
# 6. Логирование и трассировка (RUST_LOG)
# ------------------------------------------------------------------------------
# Уровень детализации вывода структурированных логов через tracing / tracing-subscriber.
# Формат: стандартные директивы tracing/env_logger (error, warn, info, debug, trace).
# По умолчанию: info
# Обязательность: Опционально
RUST_LOG=info,hydra_checker=debug
