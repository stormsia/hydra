# ==============================================================================
# Hydra Checker Core — Конфигурационный файл окружения (.env.example)
# Модуль: hydra_checker (Высокопроизводительное асинхронное ядро сетевых проверок L4/L7)
# Используется при автономных тестах, бенчмарках, микросервисах и инициализации CheckerConfig::from_env()
# ==============================================================================

# ==============================================================================
# 1. ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (REQUIRED)
# ==============================================================================
# Примечание: В программном коде `CheckerConfig::from_env()` для обеспечения прохождения
# unit-тестов и локальной отладки предусмотрены аварийные fallback-значения по умолчанию
# (http://127.0.0.1:8080 и hydra_secret_token). Однако для промышленной эксплуатации
# (production), распределенной работы и взаимодействия с реальным Judge-сервером данные
# переменные являются СТРОГО ОБЯЗАТЕЛЬНЫМИ: без указания внешнего адреса Judge-сервера
# удаленные прокси-серверы не смогут достучаться до эхо-сервера (попытка подключиться к
# 127.0.0.1 приведет к обращению прокси на свой собственный локалхост), а проверка
# маркера ответа провалится. В Rust API конструктора `CheckerConfig::builder(...)` эти
# три параметра являются обязательными аргументами.

# Базовый HTTP URL сервера Judge для проверки незашифрованного HTTP трафика (Plain HTTP).
# Используется для прямого HTTP GET запроса через прокси. Чекер автоматически подставляет
# токен в query-параметр ?token=... или заменяет плейсхолдер {TOKEN}, а также выполняет
# асинхронный DNS-предрезолвинг хоста для исключения задержек в цикле проверок.
# Тип: String (валидный HTTP URL)
# Допустимые значения: http://<host>:<port>[/path] (может содержать плейсхолдер {TOKEN})
# Пример: http://127.0.0.1:8080 или http://judge.internal:8080/azenv.php
JUDGE_HTTP_URL=http://127.0.0.1:8080

# Базовый HTTPS URL сервера Judge для проверки защищенных туннелей.
# Применяется при тестировании туннелирования: HTTP CONNECT, SOCKS4/4a и SOCKS5.
# Чекер выполняет предрезолвинг IP-адреса хоста для чистых IPv4 SOCKS4 проверок
# и кэширует предсформированный TLS HTTP-запрос для исключения лишних аллокаций.
# Тип: String (валидный HTTPS или HTTP URL)
# Допустимые значения: https://<host>:<port>[/path] или http://<host>:<port>[/path]
# Пример: https://127.0.0.1:8443 или https://judge.internal:8443
JUDGE_HTTPS_URL=http://127.0.0.1:8080

# Статический секретный токен-маркер, ожидаемый в ответе Judge сервера.
# Чекер отправляет его в заголовке `X-Hydra-Token` и параметре `?token=...`,
# а затем валидирует обязательное присутствие этого токена в теле ответа эхо-сервера.
# Отсекает ложные срабатывания (Captive Portals отелей/WiFi, страницы блокировок провайдеров).
# Тип: String (непустая строка)
# Допустимые значения: любая криптостойкая или уникальная строка-маркер
# Пример: hydra_secret_token_prod_9f86d
JUDGE_SECRET_TOKEN=hydra_secret_token

# ==============================================================================
# 2. НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (OPTIONAL & DEFAULTS)
# ==============================================================================

# Мастер-ключ HMAC-SHA256 для синхронизированной посуточной ротации токенов.
# Если параметр задан — вместо статического токена используется динамический суточный токен,
# вычисляемый детерминированно из HMAC-SHA256(epoch_day) с 30-минутным окном допуска в полночь (UTC).
# Должен совпадать со значением SECRET_KEY / JUDGE_SECRET_KEY на сервере Judge.
# Тип: String (криптостойкая строка или hex)
# Допустимые значения: произвольная строка или 64-значный hex-хэш
# [DEFAULT: отсутствует / не задан (используется статический JUDGE_SECRET_TOKEN)]
# JUDGE_SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Максимальное количество одновременно выполняемых сетевых проверок (concurrency limit).
# Ограничивает нагрузку на семафор Tokio, дескрипторы сокетов ОС и оперативную память.
# Значение автоматически приводится к минимуму 1.
# Тип: usize (целое положительное число)
# Допустимые значения: целое число >= 1 (обычно 1000..50000)
# [DEFAULT: 5000]
CHECKER_CONCURRENCY=5000

# Таймаут на установление L4 TCP-соединения (SYN -> SYN-ACK) с прокси (в миллисекундах).
# Позволяет молниеносно отсекать мертвые IP-адреса и закрытые порты до начала протокольной фазы.
# Тип: u64 (миллисекунды)
# Допустимые значения: целое число миллисекунд >= 1 (обычно 500..10000)
# [DEFAULT: 3000]
CHECKER_CONNECT_TIMEOUT_MS=3000

# Таймаут на протокольное рукопожатие туннеля (в миллисекундах).
# Включает согласование SOCKS4/SOCKS5, отправку HTTP CONNECT и согласование TLS-сессии.
# Тип: u64 (миллисекунды)
# Допустимые значения: целое число миллисекунд >= 1 (обычно 1000..15000)
# [DEFAULT: 4000]
CHECKER_HANDSHAKE_TIMEOUT_MS=4000

# Таймаут на отправку L7 HTTP-запроса через туннель и получение полного ответа от Judge (в миллисекундах).
# Тип: u64 (миллисекунды)
# Допустимые значения: целое число миллисекунд >= 1 (обычно 1000..30000)
# [DEFAULT: 5000]
CHECKER_READ_WRITE_TIMEOUT_MS=5000

# Максимальный размер считываемого тела ответа от эхо-сервера в байтах.
# Защищает чекер от атак исчерпания памяти и DoS при попадании на tarpit / endless HTTP stream.
# Значение автоматически приводится к минимуму 1 байт.
# Тип: usize (байты)
# Допустимые значения: целое число байт >= 1 (обычно 4096..65536)
# [DEFAULT: 8192]
CHECKER_MAX_READ_BYTES=8192

# Принудительная привязка исходящих сокетов чекера к локальному IP сетевого интерфейса (SO_BINDTODEVICE / bind).
# Актуально для серверов с несколькими внешними IP, сетевыми картами или маршрутизацией через VPN.
# Тип: IpAddr (IPv4 или IPv6)
# Допустимые значения: валидный IP сетевого интерфейса хоста (например, 192.168.1.100 или 2001:db8::2)
# [DEFAULT: отсутствует (выбор интерфейса определяется системной таблицей маршрутизации ОС)]
# CHECKER_LOCAL_BIND_IP=192.168.1.100

# Реальные внешние публичные IP-адреса хоста, на котором выполняется проверка.
# Критически важен для классификации уровня анонимности прокси:
#   - Transparent : если в эхо-ответе (REMOTE_ADDR, origin, X-Forwarded-For) найден реальный IP хоста.
#   - Anonymous   : если реальный IP скрыт, но прокси сообщает о себе через заголовки Via/Proxy-*.
#   - Elite       : если реальный IP скрыт и прокси не добавляет никаких идентификационных заголовков.
# Также используется для фильтрации Bogon/SSRF и предотвращения случайного сканирования своей инфраструктуры.
#
# Если параметр не задан (закомментирован или пуст), чекер автоматически динамически
# определяет сетевую идентичность (HostIdentity): собирает адреса локальных сетевых интерфейсов
# хоста (публичные IPv4, IPv6 и вычисляет /64 подсети), а также дополняет их внешними IP
# через опрос судей (что корректно пробивает NAT/Docker).
# Статическое указание CHECKER_REAL_IPS (или алиаса CHECKER_REAL_IP) переопределяет автодетект.
#
# Тип: String (IP или список IP / CIDR через запятую или точку с запятой)
# Допустимые значения: одиночный IP или список (например: 203.0.113.195, 198.51.100.42, 2001:db8:cafe::/64)
# [DEFAULT: отсутствует (активируется автоматический композитный детект через интерфейсы и судей)]
# CHECKER_REAL_IPS=203.0.113.195, 2001:db8::/64
# CHECKER_REAL_IP=203.0.113.195

# Включение проверенного пула публичных сторонних судей (Judge Pool fallback).
# При включении чекер регистрирует стабильные сторонние эхо-серверы:
#   - Httpbingo.org (приоритет 1)
#   - Httpbin.rs    (приоритет 2)
#   - Httpbun.com   (приоритет 3)
#   - Httpbin.org   (приоритет 4)
#   - Httpbin.dev   (приоритет 5)
# При падении или деградации основного Judge чекер мгновенно переключается на здоровых судей.
# Тип: bool
# Допустимые значения: true | false | 1 | 0 (регистронезависимо)
# [DEFAULT: true]
ENABLE_THIRD_PARTY_JUDGES=true

# Включение встроенного/основного судьи (из JUDGE_HTTP_URL / JUDGE_HTTPS_URL) в пул проверок.
# Если true — встроенный судья регистрируется в пуле с приоритетом 0.
# Если false — встроенный судья исключается из ротации (полезно при тестировании только на сторонних судьях).
# Тип: bool
# Допустимые значения: true | false | 1 | 0 (регистронезависимо)
# [DEFAULT: true]
ENABLE_BUILTIN_JUDGE=true

# Стратегия распределения проверок по пулу доступных судей:
#   - lowest_latency (или latency) : выбирать судью с наименьшим измеренным временем ответа (RTT EMA)
#   - priority                     : всегда использовать судью с наивысшим приоритетом (основной/встроенный),
#                                    переключаясь на резервных только при обнаружении сбоев
#   - round_robin (или roundrobin) : циклическое равномерное распределение запросов по кругу
# Тип: String (Enum)
# Допустимые значения: lowest_latency | latency | priority | round_robin | roundrobin
# [DEFAULT: lowest_latency]
JUDGE_SELECTION_STRATEGY=lowest_latency

# Дополнительные пользовательские сторонние судьи через запятую.
# Позволяет подключать собственные или приватные эхо-серверы (AZenv PHP, Go/Python echo judge).
# Формат: HTTP_URL|HTTPS_URL,HTTP_URL|HTTPS_URL... (или просто HTTP_URL, если HTTPS идентичен).
# Тип: String
# Допустимые значения: строка валидных URL, разделенных вертикальной чертой и запятыми
# [DEFAULT: отсутствует (пустой список)]
# ADDITIONAL_JUDGES=http://judge1.example.com/azenv.php|https://judge1.example.com/azenv.php,http://judge2.example.com/get

# Уровень детализации структурированных логов через tracing / tracing-subscriber.
# Тип: String
# Допустимые значения: error | warn | info | debug | trace, а также директивы модулей
# [DEFAULT: info,hydra_checker=debug]
RUST_LOG=info,hydra_checker=debug
