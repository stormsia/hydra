# ==============================================================================
# Hydra Checker Core — Конфигурационный файл окружения (.env.example)
# Модуль: hydra_checker (Ядро асинхронных проверок прокси и конвейер L4/L7)
# Используется при автономных тестах, бенчмарках и интеграции через CheckerConfig::from_env()
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Адресация и эндпоинты Judge сервера
# ------------------------------------------------------------------------------
# Базовый HTTP URL сервера Judge для проверки незашифрованного HTTP трафика (Plain HTTP).
# Формат: http://<host>:<port>[/path]
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTP_URL=http://127.0.0.1:8080

# Базовый HTTPS URL сервера Judge для проверки туннелей (HTTP CONNECT, SOCKS4/4a, SOCKS5).
# Формат: https://<host>:<port>[/path] или http://...
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTPS_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 2. Аутентификация и валидация эхо-маркера (Token Verification)
# ------------------------------------------------------------------------------
# Статический секретный токен / маркер, ожидаемый в ответе Judge сервера.
# Чекер передает его в запросе и верифицирует его обязательное присутствие в теле ответа.
# Формат: произвольная строка
# По умолчанию: hydra_secret_token
# Обязательность: Опционально
JUDGE_SECRET_TOKEN=hydra_secret_token

# Мастер-ключ HMAC-SHA256 для динамической посуточной ротации токенов.
# Если задан — токен для каждого дня вычисляется детерминированно из даты (epoch day)
# с поддержкой 30-минутного допуска устаревания токена в полночь UTC.
# Должен совпадать со значением SECRET_KEY / JUDGE_SECRET_KEY на сервере Judge.
# Формат: 64-значная hex-строка или криптостойкий секрет.
# По умолчанию: не задан (используется статический токен JUDGE_SECRET_TOKEN)
# Обязательность: Опционально
# JUDGE_SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# ------------------------------------------------------------------------------
# 3. Параллелизм и таймауты сетевого конвейера
# ------------------------------------------------------------------------------
# Максимальное количество параллельно выполняемых одновременных сетевых проверок.
# Регулирует количество воркеров и емкость семафора Tokio.
# По умолчанию: 5000
# Обязательность: Опционально
CHECKER_CONCURRENCY=5000

# Таймаут на установление TCP-соединения (SYN/SYN-ACK) с прокси (в миллисекундах).
# Позволяет быстро отсекать мертвые IP и недоступные порты.
# По умолчанию: 3000 (3 секунды)
# Обязательность: Опционально
CHECKER_CONNECT_TIMEOUT_MS=3000

# Таймаут на протокольное рукопожатие (SOCKS4/5 greeting, CONNECT tunnel, TLS handshake) (в мс).
# По умолчанию: 4000 (4 секунды)
# Обязательность: Опционально
CHECKER_HANDSHAKE_TIMEOUT_MS=4000

# Таймаут на отправку HTTP GET запроса через прокси и получение полного ответа от Judge (в мс).
# По умолчанию: 5000 (5 секунд)
# Обязательность: Опционально
CHECKER_READ_WRITE_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. Сетевая маршрутизация и детекция анонимности
# ------------------------------------------------------------------------------
# Максимальный размер считываемого тела ответа от эхо-сервера в байтах.
# Предотвращает переполнение буфера и DoS при встрече прокси-ловушек (tarpit / endless stream).
# По умолчанию: 8192 (8 КБ)
# Обязательность: Опционально
CHECKER_MAX_READ_BYTES=8192

# Принудительная привязка сокетов к исходящему IP-адресу локального сетевого интерфейса.
# Необходима для хостов с несколькими сетевыми интерфейсами или пулом внешних IP.
# Формат: IPv4 или IPv6 адрес (например, 192.168.1.100).
# По умолчанию: отсутствует (выбирается ОС по системной таблице маршрутизации)
# Обязательность: Опционально
# CHECKER_LOCAL_BIND_IP=192.168.1.100

# Реальный внешний публичный IP-адрес хоста, выполняющего проверки.
# Критически важен для классификации уровня анонимности (Transparent vs Anonymous vs Elite):
# если в теле эхо-ответа обнаружен этот IP — прокси помечается как Transparent.
# Формат: IPv4 или IPv6 адрес (например, 203.0.113.195).
# По умолчанию: отсутствует (классификация только по наличию заголовков Forwarded/Via)
# Обязательность: Опционально
# CHECKER_REAL_IP=203.0.113.195

# ------------------------------------------------------------------------------
# 5. Логирование и трассировка (RUST_LOG)
# ------------------------------------------------------------------------------
# Уровень детализации событий трассировки чекера.
# По умолчанию: info
# Обязательность: Опционально
RUST_LOG=info,hydra_checker=debug
