# ==============================================================================
# Hydra API Server — Конфигурационный файл окружения (.env.example)
# Модуль: hydra_api (REST API, Swagger UI, Storage, Scheduler, Batch Writer, GeoIP)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Сетевые параметры API Сервера
# ------------------------------------------------------------------------------
# Сетевой адрес и TCP-порт для входящих HTTP-запросов REST API и Swagger UI.
# Доступ к документации: http://<LISTEN_ADDR>/swagger-ui
# По умолчанию: 0.0.0.0:3000
# Обязательность: Опционально
LISTEN_ADDR=0.0.0.0:3000

# Секретный мастер-ключ для авторизации запросов к REST API.
# Передается клиентом в HTTP-заголовке `X-API-Key: <значение>`.
# Формат: произвольная криптостойкая строка (рекомендуется от 32 символов).
# По умолчанию: отсутствует (сервер не запустится без этого параметра).
# Обязательность: ОБЯЗАТЕЛЬНО
API_KEY=hydra_super_secret_api_key_change_me_in_production

# ------------------------------------------------------------------------------
# 2. Локальное хранилище данных (libSQL / SQLite WAL)
# ------------------------------------------------------------------------------
# Путь к локальному файлу базы данных libSQL на диске.
# Таблицы, схемы и индексы накатываются автоматически при первом запуске.
# По умолчанию: ./data/hydra.db
# Обязательность: Опционально
DB_PATH=./data/hydra.db

# ------------------------------------------------------------------------------
# 3. Встроенный Echo-сервер Judge (All-In-One режим для разработки)
# ------------------------------------------------------------------------------
# Если true — hydra_api автоматически запускает внутренний фоновый инстанс
# JudgeServer на порту EMBED_JUDGE_PORT параллельно с REST API.
# Для продакшена рекомендуется false (Judge выносится на отдельный VPS с белым IP).
# Формат: true | false | 1 | 0
# По умолчанию: false
# Обязательность: Опционально
EMBED_JUDGE=true

# TCP-порт для прослушивания входящих HTTP-запросов встроенного Judge.
# По умолчанию: 8080
# Обязательность: Опционально
EMBED_JUDGE_PORT=8080

# ------------------------------------------------------------------------------
# 4. Конфигурация ядра чекера (hydra_checker)
# ------------------------------------------------------------------------------
# Базовый HTTP URL эхо-сервера Judge для проверки Plain HTTP трафика.
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTP_URL=http://127.0.0.1:8080

# Базовый HTTPS URL эхо-сервера Judge для проверки TLS/CONNECT/SOCKS туннелей.
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTPS_URL=http://127.0.0.1:8080

# Статический секретный токен для проверки ответа Judge и отсева сканеров.
# Должен совпадать со значением SECRET_TOKEN на стороне Judge.
# По умолчанию: hydra_secret_token
# Обязательность: Опционально
JUDGE_SECRET_TOKEN=hydra_secret_token

# Стратегия выбора судьи из пула доступных:
# - lowest_latency: автоматически выбирать судью с минимальным измеренным RTT
# - priority: выбирать первого доступного судью по номеру приоритета
# - round_robin: распределять проверки циклически по кругу между всеми доступными судьями
# Формат: lowest_latency | priority | round_robin
# По умолчанию: lowest_latency
# Обязательность: Опционально
JUDGE_SELECTION_STRATEGY=lowest_latency

# (Опционально) Мастер-ключ HMAC-SHA256 для динамической посуточной ротации токенов.
# Если задан — заменяет статический токен синхронным суточным токеном.
# По умолчанию: не задан (используется статический токен)
# Обязательность: Опционально
# JUDGE_SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Лимит одновременно выполняемых параллельных проверок прокси чекером.
# По умолчанию: 5000
# Обязательность: Опционально
CHECKER_CONCURRENCY=5000

# ------------------------------------------------------------------------------
# 5. Гео-обогащение MaxMind GeoLite2 & Автообновление
# ------------------------------------------------------------------------------
# Включить автоматическое скачивание и регулярное обновление баз GeoLite2 из CDN.
# Зеркало wp-statistics/geo (jsDelivr CDN) с проверкой ETag / 304 Not Modified.
# Формат: true | false | 1 | 0
# По умолчанию: false
# Обязательность: Опционально
GEOIP_AUTO_UPDATE=false

# Локальные пути к файлам баз MaxMind .mmdb на диске.
# Если GEOIP_AUTO_UPDATE=true и пути не заданы, автоматически используются:
#   GEOIP_COUNTRY_PATH=./geo/GeoLite2-Country.mmdb
#   GEOIP_ASN_PATH=./geo/GeoLite2-ASN.mmdb
# Если файлы отсутствуют, сервер продолжает работу с полями country=NULL, asn=NULL.
# Обязательность: Опционально
# GEOIP_COUNTRY_PATH=./geo/GeoLite2-Country.mmdb
# GEOIP_ASN_PATH=./geo/GeoLite2-ASN.mmdb

# Период проверки и горячей перечитки файлов баз с диска (в секундах).
# Позволяет обновлять .mmdb файлы без перезапуска сервиса.
# По умолчанию: 3600 (1 час)
# Обязательность: Опционально
GEOIP_RELOAD_SECS=3600

# Интервал проверки наличия обновлений в CDN зеркале (в секундах).
# По умолчанию: 86400 (24 часа)
# Обязательность: Опционально
GEOIP_UPDATE_INTERVAL_SECS=86400

# URL-адреса CDN зеркал для скачивания архивов .mmdb.gz (или прямых .mmdb).
# По умолчанию: зеркало jsDelivr
# Обязательность: Опционально
GEOIP_COUNTRY_URL=https://cdn.jsdelivr.net/npm/geolite2-country/GeoLite2-Country.mmdb.gz
GEOIP_ASN_URL=https://cdn.jsdelivr.net/npm/geolite2-asn/GeoLite2-ASN.mmdb.gz

# ------------------------------------------------------------------------------
# 6. Планировщик (Scheduler) и пакетная запись (Batch Writer)
# ------------------------------------------------------------------------------
# Максимальное количество созревших прокси, выбираемых планировщиком каждую секунду.
# По умолчанию: 10000
# Обязательность: Опционально
SCHEDULER_BATCH_SIZE=10000

# Интервал сброса буфера результатов проверок в БД (в миллисекундах).
# По умолчанию: 100 (100 миллисекунд)
# Обязательность: Опционально
BATCH_FLUSH_INTERVAL_MS=100

# ------------------------------------------------------------------------------
# 7. Обслуживание базы данных и очистка мертвых прокси
# ------------------------------------------------------------------------------
# Срок хранения окончательно мертвых прокси (dead_permanent) в днях.
# По истечении этого срока они автоматически удаляются фоновым процессом обслуживания.
# По умолчанию: 30 (30 дней)
# Обязательность: Опционально
DEAD_PROXY_RETENTION_DAYS=30

# Интервал регулярного фонового обслуживания базы данных (в секундах).
# Включает удаление старых dead_permanent, неблокирующий чекпоинт WAL и PRAGMA optimize.
# По умолчанию: 3600 (1 час)
# Обязательность: Опционально
DB_MAINTENANCE_INTERVAL_SECS=3600

# ------------------------------------------------------------------------------
# 8. Логирование и трассировка (tracing / RUST_LOG)
# ------------------------------------------------------------------------------
# Уровень детализации логов (trace, debug, info, warn, error).
# По умолчанию в коде: info,hydra_api=debug,hydra_judge=debug
# Обязательность: Опционально
RUST_LOG=info,hydra_api=debug,hydra_checker=info,hydra_judge=info
