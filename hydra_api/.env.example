# ==============================================================================
# Hydra API Server — Полный конфигурационный файл окружения (.env.example)
# Модуль: hydra_api (REST API, Swagger UI, Storage, Scheduler, Batch Writer, GeoIP)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Сетевые параметры API Сервера
# ------------------------------------------------------------------------------
# Сетевой адрес и TCP-порт для входящих HTTP-запросов REST API и Swagger UI.
# Доступ к интерактивной документации OpenAPI: http://<LISTEN_ADDR>/swagger-ui
# Формат: IP:PORT (например, 0.0.0.0:3000 или 127.0.0.1:3000)
# Тип: SocketAddr
# По умолчанию: 0.0.0.0:3000
# Обязательность: Опционально
LISTEN_ADDR=0.0.0.0:3000

# Секретный мастер-ключ для авторизации запросов к REST API.
# Передается клиентом в HTTP-заголовке `X-API-Key: <значение>`.
# Формат: произвольная криптостойкая строка (рекомендуется от 32 символов).
# Тип: String
# По умолчанию: отсутствует (сервер вернет ошибку конфигурации и завершит работу)
# Обязательность: ОБЯЗАТЕЛЬНО
API_KEY=hydra_super_secret_api_key_change_me_in_production

# ------------------------------------------------------------------------------
# 2. Локальное хранилище данных (libSQL / SQLite WAL)
# ------------------------------------------------------------------------------
# Путь к локальному файлу базы данных libSQL на диске.
# Также поддерживается значение `:memory:` для временной базы в оперативной памяти.
# Таблицы, схемы и индексы накатываются автоматически при первом запуске (WAL-режим).
# Родительские директории создаются сервером автоматически.
# Формат: относительный/абсолютный путь к .db файлу или `:memory:`
# Тип: String
# По умолчанию: ./data/hydra.db
# Обязательность: Опционально
DB_PATH=./data/hydra.db

# ------------------------------------------------------------------------------
# 3. Встроенный Echo-сервер Judge (All-In-One режим для разработки)
# ------------------------------------------------------------------------------
# Если true — hydra_api автоматически запускает внутренний фоновый инстанс
# JudgeServer на порту EMBED_JUDGE_PORT параллельно с REST API.
# Удобно для локальной разработки и тестов без запуска отдельного бинарника hydra_judge.
# Для продакшена рекомендуется false (Judge выносится на отдельный VPS с белым IP).
# Формат: true | false | 1 | 0
# Тип: bool
# По умолчанию в коде: false (в примере включен для быстрого старта)
# Обязательность: Опционально
EMBED_JUDGE=true

# TCP-порт для прослушивания входящих HTTP-запросов встроенного Judge.
# Формат: целое число 1..65535
# Тип: u16
# По умолчанию: 8080
# Обязательность: Опционально
EMBED_JUDGE_PORT=8080

# ------------------------------------------------------------------------------
# 4. Конфигурация ядра чекера (hydra_checker)
# ------------------------------------------------------------------------------
# Базовый HTTP URL эхо-сервера Judge для проверки Plain HTTP трафика.
# Допускает явную подстановку `{TOKEN}` в пути (например: http://127.0.0.1:8080/{TOKEN}).
# При отсутствии плейсхолдера токен автоматически инжектируется в query `?token=...`.
# Формат: http://<host>:<port>[/path]
# Тип: Url (String)
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTP_URL=http://127.0.0.1:8080

# Базовый HTTPS URL эхо-сервера Judge для проверки TLS/CONNECT/SOCKS туннелей.
# Допускает явную подстановку `{TOKEN}` в пути (например: https://127.0.0.1:8080/{TOKEN}).
# При отсутствии плейсхолдера токен автоматически инжектируется в query `?token=...`.
# Формат: https://<host>:<port>[/path] или http://...
# Тип: Url (String)
# По умолчанию: http://127.0.0.1:8080
# Обязательность: Опционально
JUDGE_HTTPS_URL=http://127.0.0.1:8080

# Статический секретный токен для проверки ответа Judge и отсева сканеров.
# Должен совпадать со значением SECRET_TOKEN на стороне Judge.
# Передается в заголовке `X-Hydra-Token` или проверяется в теле ответа.
# Формат: строка
# Тип: String
# По умолчанию: hydra_secret_token
# Обязательность: Опционально
JUDGE_SECRET_TOKEN=hydra_secret_token

# (Опционально) Мастер-ключ HMAC-SHA256 для синхронизированной динамической посуточной ротации токенов.
# Если задан — заменяет статический токен динамическим 32-символьным hex-токеном ("hydra-token-v1:{epoch_day}").
# Сервер Judge принимает токены за сегодня (today) и вчера (yesterday), предоставляя полное 24-часовое окно перехода.
# Должен совпадать со значением SECRET_KEY на стороне Judge.
# Формат: шестнадцатеричная строка или криптостойкий секрет (например, 64 hex-символа).
# Тип: Option<String>
# По умолчанию: не задан (используется статический токен JUDGE_SECRET_TOKEN)
# Обязательность: Опционально
# JUDGE_SECRET_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Лимит одновременно выполняемых параллельных проверок прокси чекером.
# Ограничивает количество одновременных сокетов и сетевую нагрузку.
# Формат: положительное целое число
# Тип: usize
# По умолчанию: 5000
# Обязательность: Опционально
CHECKER_CONCURRENCY=5000

# Реальный внешний публичный IP адрес сервера, на котором запущен чекер/API.
# Используется для точной классификации прозрачных (Transparent) прокси,
# выявляя утечку исходного IP в заголовках REMOTE_ADDR или X-Forwarded-For,
# а также для предотвращения случайного сканирования собственного IP.
# Формат: IPv4 или IPv6 адрес (например, 203.0.113.195)
# Тип: Option<IpAddr>
# По умолчанию: не задан (классификация только по явным признакам/заголовкам)
# Обязательность: Опционально
# CHECKER_REAL_IP=203.0.113.195

# ------------------------------------------------------------------------------
# 5. Пул судей и мониторинг доступности (Judges & Health Checks)
# ------------------------------------------------------------------------------
# Включение встроенного судьи (builtin) в пул проверок.
# Если true — встроенный судья регистрируется с приоритетом 0.
# Если false — встроенный судья полностью исключается из маршрутизации и фонового мониторинга.
# По умолчанию: auto (true если EMBED_JUDGE=true или задан нестандартный JUDGE_HTTP_URL, иначе false).
# Формат: true | false | 1 | 0
# Тип: bool
# Обязательность: Опционально
# ENABLE_BUILTIN_JUDGE=false

# Включение пула проверенных стабильных сторонних судей (AZenv, ProxyJudge, Httpbin, Cloudflare Trace, Ipify).
# При недоступности основного судьи чекер автоматически переключается на здоровых судей из пула.
# Формат: true | false | 1 | 0
# Тип: bool
# По умолчанию: true
# Обязательность: Опционально
ENABLE_THIRD_PARTY_JUDGES=true

# Интервал периодической фоновой проверки доступности (Health Check) судей в пуле (в секундах).
# Фоновый воркер опрашивает всех зарегистрированных судей, замеряет RTT и статус.
# Судьи с 2 последовательными ошибками временно исключаются из маршрутизации.
# Формат: положительное целое число секунд
# Тип: u64
# По умолчанию: 30
# Обязательность: Опционально
JUDGE_HEALTH_CHECK_INTERVAL_SECS=30

# Стратегия выбора судьи из пула доступных и здоровых:
# - lowest_latency : автоматически выбирать судью с минимальным измеренным RTT (рекомендуется)
# - priority       : выбирать первого доступного судью по номеру приоритета
# - round_robin    : циклически распределять проверки по очереди между всеми доступными судьями
# Формат: lowest_latency | priority | round_robin (или roundrobin)
# Тип: String
# По умолчанию: lowest_latency
# Обязательность: Опционально
JUDGE_SELECTION_STRATEGY=lowest_latency

# Дополнительные пользовательские сторонние судьи через запятую.
# Формат: HTTP_URL|HTTPS_URL,HTTP_URL|HTTPS_URL...
# Пример: http://myjudge.example.com/azenv.php|https://myjudge.example.com/azenv.php
# Тип: Option<String>
# По умолчанию: не задано (используются основной судья + встроенный пул)
# Обязательность: Опционально
# ADDITIONAL_JUDGES=http://judge1.example.com/azenv.php|https://judge1.example.com/azenv.php,http://judge2.example.com/azenv.php|https://judge2.example.com/azenv.php

# ------------------------------------------------------------------------------
# 6. Гео-обогащение MaxMind GeoLite2 & Автообновление
# ------------------------------------------------------------------------------
# Включить автоматическое скачивание и регулярное обновление баз GeoLite2 из CDN.
# Используется зеркало wp-statistics/geo (jsDelivr CDN) с проверкой ETag / 304 Not Modified.
# Формат: true | false | 1 | 0
# Тип: bool
# По умолчанию: true
# Обязательность: Опционально
GEOIP_AUTO_UPDATE=true

# Локальные пути к файлам баз MaxMind .mmdb на диске.
# Если GEOIP_AUTO_UPDATE=true и пути не заданы, автоматически используются:
#   GEOIP_COUNTRY_PATH=./geo/GeoLite2-Country.mmdb
#   GEOIP_ASN_PATH=./geo/GeoLite2-ASN.mmdb
# Если файлы отсутствуют, сервер продолжает работу с полями country=NULL, asn=NULL.
# Формат: путь к файлу .mmdb на диске
# Тип: Option<String>
# По умолчанию: не заданы (или ./geo/GeoLite2-*.mmdb при GEOIP_AUTO_UPDATE=true)
# Обязательность: Опционально
# GEOIP_COUNTRY_PATH=./geo/GeoLite2-Country.mmdb
# GEOIP_ASN_PATH=./geo/GeoLite2-ASN.mmdb

# Период проверки и горячей перечитки файлов баз с диска (в секундах).
# Позволяет обновлять .mmdb файлы на лету без перезапуска сервиса hydra_api.
# Формат: положительное целое число секунд
# Тип: u64
# По умолчанию: 3600 (1 час)
# Обязательность: Опционально
GEOIP_RELOAD_SECS=3600

# Интервал проверки наличия обновлений в CDN зеркале (в секундах).
# Формат: положительное целое число секунд
# Тип: u64
# По умолчанию: 86400 (24 часа)
# Обязательность: Опционально
GEOIP_UPDATE_INTERVAL_SECS=86400

# URL-адреса CDN зеркал для скачивания архивов .mmdb.gz (или прямых .mmdb).
# Формат: валидный HTTPS URL
# Тип: String
# По умолчанию: зеркало jsDelivr geolite2
# Обязательность: Опционально
GEOIP_COUNTRY_URL=https://cdn.jsdelivr.net/npm/geolite2-country/GeoLite2-Country.mmdb.gz
GEOIP_ASN_URL=https://cdn.jsdelivr.net/npm/geolite2-asn/GeoLite2-ASN.mmdb.gz

# ------------------------------------------------------------------------------
# 7. Планировщик (Scheduler) и пакетная запись (Batch Writer)
# ------------------------------------------------------------------------------
# Максимальное количество созревших прокси, выбираемых планировщиком каждую секунду
# для постановки в очередь на сетевую проверку (limit выборки по next_check_at <= now).
# Формат: положительное целое число
# Тип: usize
# По умолчанию: 10000
# Обязательность: Опционально
SCHEDULER_BATCH_SIZE=10000

# Интервал сброса буфера результатов проверок из памяти в базу данных (в миллисекундах).
# Результаты проверок накапливаются в MPSC-канале и сбрасываются пакетом в единой транзакции.
# Формат: положительное целое число миллисекунд
# Тип: u64
# По умолчанию: 100 (100 миллисекунд)
# Обязательность: Опционально
BATCH_FLUSH_INTERVAL_MS=100

# ------------------------------------------------------------------------------
# 8. Обслуживание базы данных и очистка мертвых прокси
# ------------------------------------------------------------------------------
# Срок хранения окончательно мертвых прокси (dead_permanent) в днях.
# По истечении этого срока они автоматически удаляются фоновым процессом обслуживания.
# Формат: положительное целое число дней
# Тип: u32
# По умолчанию: 30 (30 дней)
# Обязательность: Опционально
DEAD_PROXY_RETENTION_DAYS=30

# Интервал регулярного фонового обслуживания базы данных (в секундах).
# Включает удаление старых dead_permanent, неблокирующий чекпоинт WAL (PRAGMA wal_checkpoint(PASSIVE)),
# дефрагментацию страниц (incremental_vacuum) и оптимизацию статистики индексов (PRAGMA optimize).
# Формат: положительное целое число секунд
# Тип: u64
# По умолчанию: 3600 (1 час)
# Обязательность: Опционально
DB_MAINTENANCE_INTERVAL_SECS=3600

# ------------------------------------------------------------------------------
# 9. Логирование и трассировка (tracing / RUST_LOG)
# ------------------------------------------------------------------------------
# Уровень детализации системного журнала и событий трассировки.
# Поддерживает синтаксис директив EnvFilter: error, warn, info, debug, trace.
# Формат: строка фильтра tracing-subscriber
# Тип: String
# По умолчанию в коде: info,hydra_api=debug,hydra_judge=debug
# Обязательность: Опционально
RUST_LOG=info,hydra_api=debug,hydra_checker=info,hydra_judge=info
